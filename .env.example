# apps/api process configuration (Sprint 1.2, apps/api/src/platform/config/env.schema.ts).
# Copy to .env and adjust. Every value except DATABASE_URL has a safe
# default for local development. Validated at boot: an invalid value
# refuses to start the process rather than silently falling back (see
# env.schema.ts's validateEnv).

# development | test | production
NODE_ENV=development

# HTTP port the API listens on.
PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Mount the Swagger UI at /docs. Set to false before deploying anywhere
# reachable outside the VPC, until Sprint 1.4 authentication can gate it.
API_DOCS_ENABLED=true

# Required, no default - the process refuses to boot without a database to
# connect to (Sprint 1.3). db/schema.prisma reads this directly.
# For local development: docker run --name ecclesia-db -e POSTGRES_USER=ecclesia \
#   -e POSTGRES_PASSWORD=ecclesia -e POSTGRES_DB=ecclesia_dev -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://ecclesia:ecclesia@localhost:5432/ecclesia_dev
