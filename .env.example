# apps/api process configuration (Sprint 1.2, apps/api/src/platform/config/env.schema.ts).
# Copy to .env and adjust - every value below has a safe default for local
# development, so a fresh checkout runs with none of this set at all.
# Validated at boot: an invalid value refuses to start the process rather
# than silently falling back (see env.schema.ts's validateEnv).

# development | test | production
NODE_ENV=development

# HTTP port the API listens on.
PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Mount the Swagger UI at /docs. Set to false before deploying anywhere
# reachable outside the VPC, until Sprint 1.4 authentication can gate it.
API_DOCS_ENABLED=true
