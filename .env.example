# apps/api and apps/worker process configuration. Copy to .env and adjust.
# Every value except DATABASE_URL, the COGNITO_* variables, and the
# AWS_REGION/SQS_* variables has a safe default for local development.
# Validated at boot: an invalid value refuses to start the process rather
# than silently falling back (see each app's own env.schema.ts's
# validateEnv).

# =============================================================================
# apps/api (Sprint 1.2, apps/api/src/platform/config/env.schema.ts)
# =============================================================================

# development | test | production
NODE_ENV=development

# HTTP port the API listens on.
PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Mount the Swagger UI at /docs. Set to false before deploying anywhere
# reachable outside the VPC, until authentication (below) can gate it.
API_DOCS_ENABLED=true

# Required, no default - the process refuses to boot without a database to
# connect to (Sprint 1.3). db/schema.prisma reads this directly.
# For local development: docker run --name ecclesia-db -e POSTGRES_USER=ecclesia \
#   -e POSTGRES_PASSWORD=ecclesia -e POSTGRES_DB=ecclesia_dev -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://ecclesia:ecclesia@localhost:5432/ecclesia_dev

# Required, no default (Sprint 1.4, Blueprint §8.1 ADR-004) - the process
# refuses to boot without a Cognito User Pool to verify access tokens
# against. There is no local/offline substitute: a real AWS Cognito User
# Pool must exist (see apps/api/src/platform/auth/AUTH_DESIGN_NOTES.md for
# what apps/api itself can and cannot verify without one, and
# db/DESIGN_NOTES.md's platform.users open questions).
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-app-client-id
COGNITO_REGION=us-east-1

# =============================================================================
# apps/worker (Worker milestone, apps/worker/src/platform/config/env.schema.ts)
# =============================================================================
# apps/worker connects to the same Postgres database as apps/api - reuse
# the DATABASE_URL value above. LOG_LEVEL/NODE_ENV above apply to both
# processes too; only the AWS/SQS variables below are worker-specific.

# Required, no default (Blueprint §10.1/§10.2, ADR-007) - the Worker
# process refuses to boot without a region to reach EventBridge/SQS in.
# There is no local/offline substitute in this codebase - a real
# provisioned EventBridge bus and SQS queue must exist (see
# apps/worker/WORKER_DESIGN_NOTES.md for what apps/worker can and cannot
# verify without one).
AWS_REGION=us-east-1

# Fixed architectural constant (Blueprint §10.2 names this bus), defaulted
# rather than required.
EVENTBRIDGE_BUS_NAME=ecclesia-engagement-signals

# Required, no default - the insights-consumer's own SQS queue URL
# (Blueprint §10.2 names the queue `insights-consumer`; the queue URL,
# not just the name, is what the AWS SDK's receive/delete calls need).
SQS_INSIGHTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/insights-consumer

# Required, no default - same reasoning, the notification-consumer and
# audit-consumer queues (Worker follow-up milestone).
SQS_NOTIFICATION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/notification-consumer
SQS_AUDIT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/audit-consumer
