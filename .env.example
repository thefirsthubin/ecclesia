# apps/api and apps/worker process configuration. Copy to .env and adjust.
# Every value except DATABASE_URL, the COGNITO_* variables, and the
# AWS_REGION/SQS_* variables has a safe default for local development.
# Validated at boot: an invalid value refuses to start the process rather
# than silently falling back (see each app's own env.schema.ts's
# validateEnv).

# =============================================================================
# apps/api (Sprint 1.2, apps/api/src/platform/config/env.schema.ts)
# =============================================================================

# development | test | production
NODE_ENV=development

# HTTP port the API listens on.
PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Mount the Swagger UI at /docs. Set to false before deploying anywhere
# reachable outside the VPC, until authentication (below) can gate it.
API_DOCS_ENABLED=true

# Required, no default - the process refuses to boot without a database to
# connect to (Sprint 1.3). db/schema.prisma reads this directly.
# For local development: docker run --name ecclesia-db -e POSTGRES_USER=ecclesia \
#   -e POSTGRES_PASSWORD=ecclesia -e POSTGRES_DB=ecclesia_dev -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://ecclesia:ecclesia@localhost:5432/ecclesia_dev

# Required, no default (Row-Level Security sprint) - connection string for
# PrismaService, the RLS-scoped client every ordinary business query uses.
# Must point at ecclesia_app, the non-owner role
# db/migrations/20260801050000_row_level_security_enforcement creates -
# apply that migration, then create the role's password to match here (the
# migration creates the role with a placeholder password - see its own SQL
# comment). DATABASE_URL above stays pointed at the ecclesia owner role,
# used only by PrismaRootService for the handful of pre-Branch-known
# identity lookups - see db/ROW_LEVEL_SECURITY_DESIGN_NOTES.md.
APP_DATABASE_URL=postgresql://ecclesia_app:ecclesia_app@localhost:5432/ecclesia_dev

# cognito | development (Development Authentication sprint,
# apps/api/src/platform/auth/DEVELOPMENT_AUTHENTICATION_GUIDE.md). Selects
# which identity provider AuthGuard verifies tokens against. Optional -
# when unset, inferred from NODE_ENV ("development" -> development mode,
# everything else -> cognito, the safe default). AUTH_MODE=development is
# refused at boot whenever NODE_ENV=production, even if set explicitly -
# see auth-mode.ts's assertAuthModeIsSafe. Leave this commented out (or set
# to "cognito") in any environment other than your own local machine.
# AUTH_MODE=development

# Required when AUTH_MODE resolves to "cognito" (the default outside local
# development), no default (Sprint 1.4, Blueprint §8.1 ADR-004) - the
# process refuses to boot without a Cognito User Pool to verify access
# tokens against. Not required, and not read at all, when AUTH_MODE
# resolves to "development" - see
# apps/api/src/platform/auth/DEVELOPMENT_AUTHENTICATION_GUIDE.md and
# AUTH_DESIGN_NOTES.md for what apps/api itself can and cannot verify
# without a real Cognito User Pool, and db/DESIGN_NOTES.md's platform.users
# open questions.
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-app-client-id
COGNITO_REGION=us-east-1

# Comma-separated list of origins main.ts's app.enableCors() allows.
# Optional - when unset, defaults to http://localhost:4200 (apps/web-admin's
# dev server) if NODE_ENV=development, otherwise CORS stays disabled
# entirely. Set this explicitly for any real deployment where web-admin is
# served from a different origin than this API - otherwise every browser
# request from it (including GET /auth/mode, so the login page itself)
# will silently fail with no server-side error to look at. See
# apps/api/src/platform/config/cors.ts.
# CORS_ORIGIN=https://admin.example.org

# =============================================================================
# apps/worker (Worker milestone, apps/worker/src/platform/config/env.schema.ts)
# =============================================================================
# apps/worker connects to the same Postgres database as apps/api - reuse
# the DATABASE_URL and APP_DATABASE_URL values above (Row-Level Security
# sprint: apps/worker's own PrismaService/PrismaRootService need the same
# two connection strings apps/api's do - see
# db/ROW_LEVEL_SECURITY_DESIGN_NOTES.md). LOG_LEVEL/NODE_ENV above apply to
# both processes too; only the AWS/SQS variables below are worker-specific.

# Required, no default (Blueprint §10.1/§10.2, ADR-007) - the Worker
# process refuses to boot without a region to reach EventBridge/SQS in.
# There is no local/offline substitute in this codebase - a real
# provisioned EventBridge bus and SQS queue must exist (see
# apps/worker/WORKER_DESIGN_NOTES.md for what apps/worker can and cannot
# verify without one).
AWS_REGION=us-east-1

# Fixed architectural constant (Blueprint §10.2 names this bus), defaulted
# rather than required.
EVENTBRIDGE_BUS_NAME=ecclesia-engagement-signals

# Required, no default - the insights-consumer's own SQS queue URL
# (Blueprint §10.2 names the queue `insights-consumer`; the queue URL,
# not just the name, is what the AWS SDK's receive/delete calls need).
SQS_INSIGHTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/insights-consumer

# Required, no default - same reasoning, the notification-consumer and
# audit-consumer queues (Worker follow-up milestone).
SQS_NOTIFICATION_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/notification-consumer
SQS_AUDIT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/audit-consumer
