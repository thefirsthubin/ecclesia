# pnpm + Nx compatibility (Sprint 0 repair).
#
# Nx's webpack/build tooling (dependency-graph walking, generatePackageJson,
# some executors' internal require()s) was originally written assuming an
# npm/yarn-style hoisted node_modules tree. pnpm's default strict, symlinked
# .pnpm store trips up that class of tooling in ways that surface as
# generic internal errors rather than clear "module not found" messages.
# shamefully-hoist keeps pnpm's content-addressable store (so we still get
# pnpm's disk/install-speed benefits) but also hoists everything into the
# root node_modules, which is what Nx's tooling expects to walk.
shamefully-hoist=true
strict-peer-dependencies=false
