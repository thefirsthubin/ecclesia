# Cloud Runtime Infrastructure milestone (Milestone 10). Build context for
# apps/api/Dockerfile and apps/worker/Dockerfile is the repo root (Nx
# monorepo builds need the whole workspace - see those Dockerfiles' own
# top comments) - this keeps that context to what a Docker build actually
# needs, both for build speed and because `DockerImageAsset` (CDK's own
# image-asset construct, `infra/lib/constructs/fargate-service.construct.ts`)
# stages/hashes the same file set this excludes.
node_modules
**/node_modules
.git
.nx
dist
coverage
infra/cdk.out
infra/node_modules
**/*.log
.env
.env.local
.env.*.local
.DS_Store
