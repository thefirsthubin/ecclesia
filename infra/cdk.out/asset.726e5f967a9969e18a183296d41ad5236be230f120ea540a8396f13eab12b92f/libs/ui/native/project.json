{
  "name": "ui-native",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/ui/native/src",
  "tags": ["scope:ui-native"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/ui/native",
        "main": "libs/ui/native/src/index.ts",
        "tsConfig": "libs/ui/native/tsconfig.lib.json",
        "assets": ["libs/ui/native/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/ui/native/**/*.ts", "libs/ui/native/**/*.tsx"]
      }
    }
  }
}
