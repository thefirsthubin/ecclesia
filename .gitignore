.nx/polygraph
.claude/worktrees
.claude/settings.local.json
node_modules
.DS_Store

# Incremental build/typecheck cache written by the @nx/js/typescript
# plugin's `typecheck` target (`tsc --build`, project-reference
# .tsbuildinfo files) - ephemeral, regenerated on every run, distinct
# from dist/apps and dist/libs (this workspace's real build output - now
# also ignored below, not tracked, per the Release 1 Git Working Tree
# Audit).
dist/out-tsc

# Real build output (`nx build`/`nx serve` for every app and lib) -
# regenerated on demand, never meant to be committed. Confirmed via the
# Release 1 Git Working Tree Audit that nothing under dist/ was actually
# tracked despite the stale claim the comment above used to make.
dist/apps/
dist/libs/

# Nx local cache/daemon state (Git Working Tree Audit finding) -
# ephemeral, regenerated by every `nx` invocation, machine/session-
# specific. Distinct from `.nx/polygraph` above (already ignored) and
# from dist/out-tsc above (also cache, but the TypeScript compiler's, not
# Nx's own task-cache/daemon-workspace-data).
.nx/cache/
.nx/workspace-data/

# Local AI-assistant tool configuration (Claude Code, OpenCode) - not
# application code. `.claude/settings.local.json` is already ignored
# above; `.claude/settings.json` is the same class of local tool config -
# this repo's own history already reverted this class of file once
# (commit aadbefa7, "remove agent-tooling config files accidentally
# committed"). `.opencode/` and `opencode.json` are the equivalent
# config for a second AI coding tool.
.claude/settings.json
.opencode/
opencode.json

# AWS CDK synth output (`infra/cdk.out`) - regenerated by every `cdk
# synth`/infra test run. Was previously untracked-but-not-ignored, which
# was harmless until registering the @nx/js/typescript plugin: that
# plugin discovers a project at every tsconfig.json in the workspace, and
# cdk.out's Lambda-bundling asset directories contain full copies of
# apps/libs source (tsconfig.json included) for packaging, which Nx then
# reported as duplicate projects of the real ones. Nx's own file-walker
# already excludes anything gitignored, so this single entry is the
# project-discovery-exclusion fix for that, not a workaround touching the
# generated assets themselves.
cdk.out/
infra/cdk.out/

# Sprint 1.2: process config (apps/api/src/platform/config/env.schema.ts).
# .env.example is the tracked template - real .env files hold whatever
# Sprint 1.3/1.4 add next (DATABASE_URL, Cognito secrets) and must never
# be committed.
.env
.env.local
.env.*.local
node_modules
