{
  "name": "web-admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-admin/src",
  "tags": [
    "scope:app"
  ],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "compiler": "babel",
        "outputPath": "dist/apps/web-admin",
        "index": "apps/web-admin/index.html",
        "baseHref": "/",
        "main": "apps/web-admin/src/main.tsx",
        "tsConfig": "apps/web-admin/tsconfig.app.json",
        "assets": [
          "apps/web-admin/src/assets"
        ],
        "styles": [
          "apps/web-admin/src/styles.css"
        ],
        "webpackConfig": "apps/web-admin/webpack.config.js"
      },
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "fileReplacements": [],
          "optimization": true,
          "sourceMap": false
        }
      }
    },
    "serve": {
      "executor": "@nx/webpack:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "web-admin:build",
        "port": 4200
      },
      "configurations": {
        "development": {
          "buildTarget": "web-admin:build:development"
        },
        "production": {
          "buildTarget": "web-admin:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/web-admin/**/*.ts",
          "apps/web-admin/**/*.tsx"
        ]
      }
    }
  }
}
