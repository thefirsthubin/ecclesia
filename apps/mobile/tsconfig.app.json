{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "allowJs": true
  },
  "exclude": [
    "jest.config.ts",
    "src/test-setup.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.js", "src/**/*.jsx"],
  "references": [
    { "path": "../../libs/contracts/tsconfig.lib.json" },
    { "path": "../../libs/ui/tokens/tsconfig.lib.json" },
    { "path": "../../libs/ui/core/tsconfig.lib.json" },
    { "path": "../../libs/ui/native/tsconfig.lib.json" }
  ]
}
