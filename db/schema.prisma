generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["gatherings", "insights", "ministry", "pastoral_care", "people", "platform", "stewardship"]
}

/// [PRD-DERIVED] FR-ADM-03 ("Branch and Council as first-class entities
/// from Release 1"); PRD §12.3's ERD: COUNCIL ||--o{ BRANCH : oversees.
///
/// [Multi-Tenant Foundation, Phase 1] `tenantId` + `@@unique` added:
/// every Council now belongs to exactly one Tenant, and - per this
/// phase's locked product decision (ONE TENANT = ONE COUNCIL) - no two
/// Councils may share a Tenant. See `Tenant`'s own doc comment (below,
/// near the end of this file - introspection appended it there when it
/// re-discovered `platform.tenants` with no existing model mapped to it;
/// left in place rather than relocated, to keep this fix's diff minimal).
model Council {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId        String           @unique @map("tenant_id") @db.Uuid
  roleAssignments RoleAssignment[]
  branches        Branch[]
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("councils")
  @@schema("platform")
}

/// [BLUEPRINT-EXACT] Blueprint §7.2's table list; §7.3's RLS policy scopes
/// every Branch-scoped table to `branch_id`, making Branch the tenant root.
model Branch {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  councilId                String                    @map("council_id") @db.Uuid
  name                     String
  timezone                 String?
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  gatheringSeries          GatheringSeries[]
  gatherings               Gathering[]
  visitorIntakeSubmissions VisitorIntakeSubmission[]
  alerts                   Alert[]
  engagementSignals        EngagementSignal[]
  pulseScoreHistory        PulseScoreHistory[]
  pulseScores              PulseScore[]
  followUpTasks            FollowUpTask[]
  pastoralNotes            PastoralNote[]
  silentDriftFlags         SilentDriftFlag[]
  groups                   Group[]
  persons                  Person[]
  roleAssignments          RoleAssignment[]
  auditLogEntries          AuditLog[]
  council                  Council                   @relation(fields: [councilId], references: [id])
  configuration            Configuration?
  processedEvents          ProcessedEvent[]
  users                    User[]
  bankDepositConfirmations BankDepositConfirmation[]
  financialTransactions    FinancialTransaction[]
  projects                 Project[]

  @@map("branches")
  @@schema("platform")
}

/// [PRD-DERIVED] Blueprint §8 (Cognito-backed identity). Minimal shape for
/// Sprint 1.3 - only enough for other tables' actor_user_id/user_id
/// foreign keys to resolve. Full Cognito integration (MFA state, custom
/// attributes) is Sprint 1.4's scope - see db/DESIGN_NOTES.md.
model User {
  id                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId               String                      @map("branch_id") @db.Uuid
  personId               String?                     @unique @map("person_id") @db.Uuid
  cognitoSub             String                      @unique @map("cognito_sub")
  authMethod             AuthMethod                  @map("auth_method")
  phone                  String?
  email                  String?
  mfaEnabled             Boolean                     @default(false) @map("mfa_enabled")
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  roleAssignmentsGranted RoleAssignment[]            @relation("RoleAssignmentGrantedBy")
  auditLogEntries        AuditLog[]
  sessions               Session[]
  branch                 Branch                      @relation(fields: [branchId], references: [id])
  person                 Person?                     @relation(fields: [personId], references: [id])
  financialEventsActed   FinancialTransactionEvent[] @relation("FinancialEventActor")

  @@index([branchId])
  @@map("users")
  @@schema("platform")
}

/// [PRD-DERIVED] Named in Blueprint §7.2's table list with no schema
/// detail elsewhere - the least-evidenced table in this migration. See
/// db/DESIGN_NOTES.md Open Question #4.
model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  deviceId  String?   @map("device_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("platform")
}

/// [PRD-DERIVED] Table name/purpose from Blueprint §7.2; field list from
/// libs/rbac's BranchConfiguration doc comment (gatheringTypes,
/// followupSlaDefaults) plus [BLUEPRINT-EXACT] poimenGateEnabled
/// (Blueprint §9.3, exact field name) plus silentDriftConfig (PRD §15.8:
/// the N/M thresholds are "configuration", shape not otherwise specified).
model Configuration {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId            String   @unique @map("branch_id") @db.Uuid
  gatheringTypes      String[] @map("gathering_types")
  churchPulseWeights  Json     @map("church_pulse_weights")
  /// [BLUEPRINT-EXACT] Blueprint §9.3: "reads a poimen_gate_enabled
  /// boolean from platform.configurations".
  poimenGateEnabled   Boolean  @default(false) @map("poimen_gate_enabled")
  followupSlaDefaults Json     @map("followup_sla_defaults")
  /// [PRD-DERIVED] PRD §15.8 - silent-drift attendance/Bacenta thresholds
  /// (N, M), shape not pinned beyond being Branch-configurable.
  silentDriftConfig   Json     @map("silent_drift_config")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("configurations")
  @@schema("platform")
}

/// [BLUEPRINT-EXACT] Table named in §7.2; actor tracked via `actor_user_id`
/// per §8.5 ("every authentication event... logged... with the
/// authenticated user, device identifier, IP address") and by analogy to
/// §7.4's actor_user_id pattern for the RBAC-denial-logging use case.
model AuditLog {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId     String?              @map("branch_id") @db.Uuid
  actorUserId  String?              @map("actor_user_id") @db.Uuid
  /// The libs/rbac Action string, e.g. "stewardship.transaction.verify",
  /// or an auth-event name for §8.5's login/logout/MFA logging use case.
  action       String
  effect       AuthorizationEffect?
  resourceType String?              @map("resource_type")
  resourceId   String?              @map("resource_id")
  reason       String?
  deviceId     String?              @map("device_id")
  ipAddress    String?              @map("ip_address")
  occurredAt   DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUser    User?                @relation(fields: [actorUserId], references: [id])
  branch       Branch?              @relation(fields: [branchId], references: [id])

  @@index([branchId, occurredAt])
  @@map("audit_log")
  @@schema("platform")
}

/// [BLUEPRINT-EXACT] Blueprint §10.5: "EventBridge/SQS provide
/// at-least-once delivery... every consumer... uses `eventId` as an
/// idempotency key: a `processed_events` table (per consumer) records
/// which `eventId`s have already been applied, and processing is a
/// no-op on replay." `consumerName` distinguishes the three named
/// consumers (§10.2: `insights-consumer`, `notification-consumer`,
/// `audit-consumer`) sharing one physical table rather than three - a
/// single table with a compound unique index is simpler than three
/// near-identical tables for the same "have I seen this eventId before"
/// check, and Prisma/Postgres both handle a compound unique index at
/// this scale without difficulty. `branchId` is carried because every
/// `EngagementSignalEnvelope` (§10.3) already includes one - denormalized
/// here the same way every other Branch-scoped table in this schema
/// denormalizes it, so the standard RLS `branch_isolation` policy applies
/// unchanged (see db/DESIGN_NOTES.md Worker milestone entry).
model ProcessedEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  consumerName String   @map("consumer_name")
  eventId      String   @map("event_id") @db.Uuid
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([consumerName, eventId])
  @@index([branchId])
  @@map("processed_events")
  @@schema("platform")
}

/// [BLUEPRINT-EXACT] PRD §12.6 - unifies Bacenta (PASTORAL_CARE) and
/// Basonta (MINISTRY) via the `type` discriminator. No Cluster type and no
/// parent/child hierarchy - see db/DESIGN_NOTES.md's corrections table.
model Group {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId                 String                    @map("branch_id") @db.Uuid
  type                     GroupType
  name                     String
  /// [PRD-DERIVED] FR-PC-01: Bacenta creation captures "name, leader,
  /// meeting schedule, meeting location" - leader is a RoleAssignment, the
  /// rest are plain fields.
  meetingSchedule          String?                   @map("meeting_schedule")
  meetingLocation          String?                   @map("meeting_location")
  /// [PRD-DERIVED] FR-MIN-01: Basonta creation captures "name, leader,
  /// purpose/category".
  category                 String?
  /// [BLUEPRINT-EXACT] PRD §12.6's lifecycle state diagram.
  lifecycleStatus          GroupLifecycleStatus      @default(ACTIVE) @map("lifecycle_status")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  gatheringSeries          GatheringSeries[]
  gatherings               Gathering[]
  engagementSignals        EngagementSignal[]
  staffingTargets          StaffingTarget[]
  followUpTasks            FollowUpTask[]
  silentDriftFlags         SilentDriftFlag[]
  groupMemberships         GroupMembership[]
  branch                   Branch                    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  roleAssignments          RoleAssignment[]
  bankDepositConfirmations BankDepositConfirmation[]
  financialTransactions    FinancialTransaction[]

  @@index([branchId, type])
  @@map("groups")
  @@schema("people")
}

/// [BLUEPRINT-EXACT] Blueprint §7.2: "includes optional nullable
/// guardian_person_id" on persons.
model Person {
  id                                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId                          String                    @map("branch_id") @db.Uuid
  firstName                         String                    @map("first_name")
  lastName                          String                    @map("last_name")
  phone                             String?
  email                             String?
  dateOfBirth                       DateTime?                 @map("date_of_birth") @db.Date
  address                           String?
  /// [BLUEPRINT-EXACT] PRD §12.5 / BR-PPL-03's exact 7-state list.
  lifecycleStage                    LifecycleStage            @default(VISITOR) @map("lifecycle_stage")
  /// [BLUEPRINT-EXACT] Blueprint §7.2's guardian_person_id, self-FK,
  /// nullable - PRD §24 OQ-01 / FR-PPL-09 (minors).
  guardianPersonId                  String?                   @map("guardian_person_id") @db.Uuid
  /// [PRD-DERIVED] FR-PPL-08 - configurable custom profile fields, shape
  /// not further specified. See db/DESIGN_NOTES.md.
  customFields                      Json?                     @map("custom_fields")
  createdAt                         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  attendanceRecords                 AttendanceRecord[]        @relation("AttendanceRecordPerson")
  attendanceRecorded                AttendanceRecord[]        @relation("AttendanceRecordRecordedBy")
  createdGatheringSeries            GatheringSeries[]         @relation("GatheringSeriesCreatedBy")
  createdGatherings                 Gathering[]               @relation("GatheringCreatedBy")
  visitorIntakeSubmission           VisitorIntakeSubmission[]
  alertsResolved                    Alert[]                   @relation("AlertResolvedBy")
  staffingTargetsCreated            StaffingTarget[]          @relation("StaffingTargetCreatedBy")
  workerAvailability                WorkerAvailability[]
  followUpTasksAssigned             FollowUpTask[]            @relation("FollowUpTaskAssignedTo")
  followUpTasksCreated              FollowUpTask[]            @relation("FollowUpTaskCreatedBy")
  followUpTasksEscalatedTo          FollowUpTask[]            @relation("FollowUpTaskEscalatedTo")
  followUpTasksSubject              FollowUpTask[]            @relation("FollowUpTaskSubject")
  pastoralNotesAuthored             PastoralNote[]            @relation("PastoralNoteAuthor")
  pastoralNotesSubject              PastoralNote[]            @relation("PastoralNoteSubject")
  poimenEnrollment                  PoimenEnrollment?
  silentDriftFlagsAssigned          SilentDriftFlag[]         @relation("SilentDriftFlagShepherd")
  silentDriftFlagsSubject           SilentDriftFlag[]         @relation("SilentDriftFlagPerson")
  groupMemberships                  GroupMembership[]
  branch                            Branch                    @relation(fields: [branchId], references: [id])
  guardian                          Person?                   @relation("PersonGuardian", fields: [guardianPersonId], references: [id])
  dependents                        Person[]                  @relation("PersonGuardian")
  roleAssignmentsHeld               RoleAssignment[]          @relation("RoleAssignmentPerson")
  user                              User?
  bankDepositConfirmationsConfirmed BankDepositConfirmation[]
  expensesApproved                  Expense[]                 @relation("ExpenseApprovedBy")
  expensesRequested                 Expense[]                 @relation("ExpenseRequestedBy")
  financialTransactionsGiven        FinancialTransaction[]    @relation("FinancialTransactionGiver")
  pledges                           Pledge[]
  projectsCreated                   Project[]                 @relation("ProjectCreatedBy")

  @@index([branchId])
  @@index([guardianPersonId])
  @@map("persons")
  @@schema("people")
}

/// [BLUEPRINT-EXACT] Table named in §7.2. Actor-tracking fields use
/// person_id (not user_id) for `grantedByPersonId` deliberately - see
/// db/DESIGN_NOTES.md's corrections table on the person_id vs user_id
/// distinction ("who is responsible for" vs. "which authenticated session
/// performed a security-relevant mutation").
/// [Multi-Tenant Foundation, Phase 1] `branchId` is now nullable and
/// `councilId` added alongside it, so a Council-scoped assignment
/// (Resident Pastor/Council Administrator/Council Treasurer) can exist
/// without being artificially pinned to one Branch - the previous
/// `branchId String` (NOT NULL) forced every Role Assignment, including a
/// would-be Council-wide one, onto exactly one Branch row, which
/// contradicts Council-wide authority by construction.
///
/// Enforced by a hand-written CHECK constraint in this phase's migration
/// (`(branch_id IS NOT NULL AND council_id IS NULL) OR (branch_id IS
/// NULL AND council_id IS NOT NULL)` - exactly one of the two, never
/// both, never neither) - not expressible in this schema file itself,
/// the same way this schema stays silent about the RLS policies every
/// Branch-scoped table already has (see db/migrations' own README).
/// Branch-scoped roles (Branch Pastor/Administrator/Treasurer, Bacenta/
/// Basonta Leader) are unaffected: they still always carry a
/// non-null `branchId`, exactly as before this change.
model RoleAssignment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId        String    @map("person_id") @db.Uuid
  role            Role
  branchId        String?   @map("branch_id") @db.Uuid
  /// The Bacenta/Basonta this assignment is scoped to. Null for
  /// Branch/Global-scoped roles.
  groupId         String?   @map("group_id") @db.Uuid
  /// [PRD-DERIVED] Open Question #1 - the Assistant Pastor "cluster" scope
  /// has no defined schema shape in either document ("cluster assignment
  /// is itself a configuration, not a hard-coded structure" - PRD §17.2).
  /// Modeled as a plain array of Bacenta group ids, populated only for
  /// cluster-scoped assignments. Not a citation - see
  /// db/DESIGN_NOTES.md Open Question #1.
  scopeGroupIds   String[]  @default([]) @map("scope_group_ids") @db.Uuid
  grantedByUserId String?   @map("granted_by_user_id") @db.Uuid
  effectiveFrom   DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo     DateTime? @map("effective_to") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  councilId       String?   @map("council_id") @db.Uuid
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  council         Council?  @relation(fields: [councilId], references: [id], onDelete: Cascade)
  grantedByUser   User?     @relation("RoleAssignmentGrantedBy", fields: [grantedByUserId], references: [id])
  group           Group?    @relation(fields: [groupId], references: [id])
  person          Person    @relation("RoleAssignmentPerson", fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, effectiveFrom, effectiveTo])
  @@index([branchId, role])
  @@index([councilId, role])
  @@map("role_assignments")
  @@schema("people")
}

/// [BLUEPRINT-EXACT] The temporal GROUP_MEMBERSHIP model, Blueprint §7.5's
/// exact DDL: started_at/ended_at (not valid_from/valid_to), required-on-
/// close `reason`, and a partial unique index enforcing exactly one active
/// PASTORAL_CARE membership per person (BR-PPL-01).
model GroupMembership {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from Person.branchId - every Branch-scoped table needs a
  /// direct branch_id column for Blueprint §7.3's RLS policy pattern.
  branchId  String    @map("branch_id") @db.Uuid
  personId  String    @map("person_id") @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  /// Denormalized from Group.type at write time so the partial unique
  /// index below (Blueprint §7.5's exact mechanism) doesn't need a join.
  groupType GroupType @map("group_type")
  startedAt DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  /// [BLUEPRINT-EXACT] Required when a membership is closed.
  reason    String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, startedAt, endedAt])
  @@index([groupId, startedAt, endedAt])
  @@index([branchId])
  @@map("group_memberships")
  @@schema("people")
}

/// [PRD-DERIVED] Table named in Blueprint §7.2; FR-PC-06 for the 3-value
/// status. Its own table, not a field on Person - Blueprint §7.2 lists
/// `poimen_enrollments` as a distinct pastoral_care table.
model PoimenEnrollment {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from Person.branchId - see GroupMembership's doc comment.
  branchId    String       @map("branch_id") @db.Uuid
  personId    String       @unique @map("person_id") @db.Uuid
  status      PoimenStatus @default(NOT_STARTED)
  enrolledAt  DateTime?    @map("enrolled_at") @db.Timestamptz(6)
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  person      Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("poimen_enrollments")
  @@schema("pastoral_care")
}

/// [PRD-DERIVED] FR-PC-03 (auto-created), FR-PC-04 (assignment to a
/// specific Person - "typically the Shepherd", SLA window, escalation).
model FollowUpTask {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId            String             @map("branch_id") @db.Uuid
  groupId             String?            @map("group_id") @db.Uuid
  personId            String             @map("person_id") @db.Uuid
  assignedToPersonId  String             @map("assigned_to_person_id") @db.Uuid
  status              FollowUpTaskStatus @default(OPEN)
  dueAt               DateTime?          @map("due_at") @db.Timestamptz(6)
  escalatedAt         DateTime?          @map("escalated_at") @db.Timestamptz(6)
  escalatedToPersonId String?            @map("escalated_to_person_id") @db.Uuid
  createdByPersonId   String?            @map("created_by_person_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignedToPerson    Person             @relation("FollowUpTaskAssignedTo", fields: [assignedToPersonId], references: [id])
  branch              Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdByPerson     Person?            @relation("FollowUpTaskCreatedBy", fields: [createdByPersonId], references: [id])
  escalatedToPerson   Person?            @relation("FollowUpTaskEscalatedTo", fields: [escalatedToPersonId], references: [id])
  group               Group?             @relation(fields: [groupId], references: [id])
  person              Person             @relation("FollowUpTaskSubject", fields: [personId], references: [id], onDelete: Cascade)

  @@index([branchId, status])
  @@index([assignedToPersonId])
  @@map("follow_up_tasks")
  @@schema("pastoral_care")
}

/// [PRD-DERIVED] §15.8's decision tree, operationalizing BR-PC-02's
/// silent-drift definition (attendance threshold N, Bacenta threshold M).
model SilentDriftFlag {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId                 String            @map("branch_id") @db.Uuid
  groupId                  String            @map("group_id") @db.Uuid
  personId                 String            @map("person_id") @db.Uuid
  attendanceMissedCount    Int               @map("attendance_missed_count")
  attendanceThreshold      Int               @map("attendance_threshold")
  bacentaMissedCount       Int               @map("bacenta_missed_count")
  bacentaThreshold         Int               @map("bacenta_threshold")
  status                   SilentDriftStatus @default(FLAGGED)
  assignedShepherdPersonId String?           @map("assigned_shepherd_person_id") @db.Uuid
  resolvedAt               DateTime?         @map("resolved_at") @db.Timestamptz(6)
  escalatedAt              DateTime?         @map("escalated_at") @db.Timestamptz(6)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  assignedShepherd         Person?           @relation("SilentDriftFlagShepherd", fields: [assignedShepherdPersonId], references: [id])
  branch                   Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  group                    Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person                   Person            @relation("SilentDriftFlagPerson", fields: [personId], references: [id], onDelete: Cascade)

  @@index([branchId, status])
  @@map("silent_drift_flags")
  @@schema("pastoral_care")
}

/// [PRD-DERIVED] §16.2 capability list; NFR-PRIV-01 (ADMIN explicit-deny
/// already encoded in libs/rbac). No updatedAt - notes appear immutable
/// once created (no update action for this resource in libs/rbac).
model PastoralNote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  personId       String   @map("person_id") @db.Uuid
  authorPersonId String   @map("author_person_id") @db.Uuid
  content        String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  authorPerson   Person   @relation("PastoralNoteAuthor", fields: [authorPersonId], references: [id])
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  person         Person   @relation("PastoralNoteSubject", fields: [personId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([personId])
  @@map("pastoral_notes")
  @@schema("pastoral_care")
}

/// [PRD-DERIVED] FR-MIN-02: "numeric staffing target against a specific
/// Gathering instance".
model StaffingTarget {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from Group.branchId - see GroupMembership's doc comment.
  branchId          String    @map("branch_id") @db.Uuid
  gatheringId       String    @map("gathering_id") @db.Uuid
  groupId           String    @map("group_id") @db.Uuid
  targetCount       Int       @map("target_count")
  createdByPersonId String    @map("created_by_person_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByPerson   Person    @relation("StaffingTargetCreatedBy", fields: [createdByPersonId], references: [id])
  gathering         Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  group             Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([gatheringId, groupId])
  @@index([branchId])
  @@map("staffing_targets")
  @@schema("ministry")
}

/// [PRD-DERIVED] §16.3: "lets a worker mark themselves unavailable for a
/// date range" - person-wide, not per-Basonta (a worker may serve more
/// than one Basonta).
model WorkerAvailability {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from Person.branchId - see GroupMembership's doc comment.
  branchId        String   @map("branch_id") @db.Uuid
  personId        String   @map("person_id") @db.Uuid
  unavailableFrom DateTime @map("unavailable_from") @db.Date
  unavailableTo   DateTime @map("unavailable_to") @db.Date
  reason          String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  person          Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, unavailableFrom, unavailableTo])
  @@index([branchId])
  @@map("worker_availability")
  @@schema("ministry")
}

/// [PRD-DERIVED] FR-GTH-02: recurring series generating dated instances.
model GatheringSeries {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId          String      @map("branch_id") @db.Uuid
  groupId           String?     @map("group_id") @db.Uuid
  /// References Configuration.gatheringTypes by name, not a foreign key.
  type              String
  recurrenceRule    String?     @map("recurrence_rule")
  startDate         DateTime    @map("start_date") @db.Date
  endDate           DateTime?   @map("end_date") @db.Date
  createdByPersonId String      @map("created_by_person_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch            Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdByPerson   Person      @relation("GatheringSeriesCreatedBy", fields: [createdByPersonId], references: [id])
  group             Group?      @relation(fields: [groupId], references: [id])
  gatherings        Gathering[]

  @@index([branchId])
  @@map("gathering_series")
  @@schema("gatherings")
}

/// [BLUEPRINT-EXACT] PRD §12.4's exact field list: type, scheduledStart,
/// scheduledEnd, recurrenceRule (via series), venue, ownerGroupId
/// (nullable), status, plus a config JSON column for type-specific fields
/// (e.g. an OnlineGathering's stream URL).
model Gathering {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId                 String                    @map("branch_id") @db.Uuid
  ownerGroupId             String?                   @map("owner_group_id") @db.Uuid
  seriesId                 String?                   @map("series_id") @db.Uuid
  type                     String
  scheduledStart           DateTime                  @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd             DateTime?                 @map("scheduled_end") @db.Timestamptz(6)
  venue                    String?
  status                   GatheringStatus           @default(SCHEDULED)
  /// Type-specific fields (e.g. stream URL for an online Gathering).
  config                   Json?
  createdByPersonId        String                    @map("created_by_person_id") @db.Uuid
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  attendanceRecords        AttendanceRecord[]
  branch                   Branch                    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdByPerson          Person                    @relation("GatheringCreatedBy", fields: [createdByPersonId], references: [id])
  ownerGroup               Group?                    @relation(fields: [ownerGroupId], references: [id])
  series                   GatheringSeries?          @relation(fields: [seriesId], references: [id])
  visitorIntakeSubmissions VisitorIntakeSubmission[]
  staffingTargets          StaffingTarget[]

  @@index([branchId, scheduledStart])
  @@index([ownerGroupId, scheduledStart])
  @@map("gatherings")
  @@schema("gatherings")
}

/// [BLUEPRINT-EXACT] Table renamed from `attendance` to `attendance_records`
/// to match the Blueprint's naming. PRD §12.2's exact 3-value status.
/// branch_id denormalized from Gathering so the RLS policy stays a simple
/// column comparison, not a join.
model AttendanceRecord {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gatheringId        String           @map("gathering_id") @db.Uuid
  personId           String           @map("person_id") @db.Uuid
  branchId           String           @map("branch_id") @db.Uuid
  status             AttendanceStatus
  recordedByPersonId String           @map("recorded_by_person_id") @db.Uuid
  recordedAt         DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(6)
  gathering          Gathering        @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  person             Person           @relation("AttendanceRecordPerson", fields: [personId], references: [id], onDelete: Cascade)
  recordedByPerson   Person           @relation("AttendanceRecordRecordedBy", fields: [recordedByPersonId], references: [id])

  @@unique([gatheringId, personId])
  @@index([branchId])
  @@map("attendance_records")
  @@schema("gatherings")
}

/// [PRD-DERIVED] FR-GTH-04; §16.1's minimal capture fields ("name, phone,
/// how they heard about the church").
model VisitorIntakeSubmission {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String     @map("branch_id") @db.Uuid
  gatheringId   String?    @map("gathering_id") @db.Uuid
  personId      String?    @map("person_id") @db.Uuid
  /// Raw captured form fields (name, phone, how they heard about the
  /// church, etc.) - shape not pinned beyond §16.1's minimal example list.
  submittedData Json       @map("submitted_data")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  gathering     Gathering? @relation(fields: [gatheringId], references: [id])
  person        Person?    @relation(fields: [personId], references: [id])

  @@index([branchId])
  @@map("visitor_intake_submissions")
  @@schema("gatherings")
}

/// [BLUEPRINT-EXACT] Blueprint §7.4's `financial_transactions` header row,
/// full DDL shown verbatim: type CHECK constraint, source_group_id,
/// giver_person_id, channel, amount stored as amount_minor BIGINT ("to
/// avoid float rounding error"), currency, current_state (denormalized).
model FinancialTransaction {
  id               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId         String                       @map("branch_id") @db.Uuid
  type             FinancialTransactionType
  sourceGroupId    String?                      @map("source_group_id") @db.Uuid
  giverPersonId    String?                      @map("giver_person_id") @db.Uuid
  channel          FinancialTransactionChannel?
  /// Stored in minor currency units (e.g. pesewas/cents) to avoid float
  /// rounding error - Blueprint §7.4's exact design rationale.
  amountMinor      BigInt                       @map("amount_minor")
  currency         String                       @default("GHS") @db.Char(3)
  /// Denormalized latest state, mirrored from the most recent
  /// financial_transaction_events row for this transaction.
  currentState     String                       @map("current_state")
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  expense          Expense?
  events           FinancialTransactionEvent[]
  branch           Branch                       @relation(fields: [branchId], references: [id])
  giverPerson      Person?                      @relation("FinancialTransactionGiver", fields: [giverPersonId], references: [id])
  sourceGroup      Group?                       @relation(fields: [sourceGroupId], references: [id])
  pledgesFulfilled Pledge[]

  @@index([branchId, type, currentState])
  @@map("financial_transactions")
  @@schema("stewardship")
}

/// [BLUEPRINT-EXACT] Blueprint §7.4's append-only event log, full DDL
/// shown verbatim: transaction_id, from_state, to_state (free-form text,
/// not a fixed enum - the real state machine has 8+ states across two
/// sub-flows per PRD §12.7), actor_user_id REFERENCES platform.users(id),
/// reason, occurred_at. No update/delete allowed - see
/// db/DESIGN_NOTES.md Open Question #2 for the enforcement mechanism.
model FinancialTransactionEvent {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String               @map("transaction_id") @db.Uuid
  fromState     String?              @map("from_state")
  toState       String               @map("to_state")
  actorUserId   String               @map("actor_user_id") @db.Uuid
  reason        String?
  occurredAt    DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUser     User                 @relation("FinancialEventActor", fields: [actorUserId], references: [id])
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("financial_transaction_events")
  @@schema("stewardship")
}

/// [PRD-DERIVED] FR-STW-09 (approver != requester, mandatory receipt
/// before a terminal state). Modeled as a 1:1 extension of a
/// financial_transactions row with type=EXPENSE, sharing that row's event
/// log for state history - see db/DESIGN_NOTES.md Open Question #5; this
/// relationship shape is my construction, not a citation.
model Expense {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from FinancialTransaction.branchId - see
  /// GroupMembership's doc comment.
  branchId            String               @map("branch_id") @db.Uuid
  transactionId       String               @unique @map("transaction_id") @db.Uuid
  requestedByPersonId String               @map("requested_by_person_id") @db.Uuid
  description         String
  category            String?
  receiptStorageKey   String?              @map("receipt_storage_key")
  approvedByPersonId  String?              @map("approved_by_person_id") @db.Uuid
  approvedAt          DateTime?            @map("approved_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  approvedByPerson    Person?              @relation("ExpenseApprovedBy", fields: [approvedByPersonId], references: [id])
  requestedByPerson   Person               @relation("ExpenseRequestedBy", fields: [requestedByPersonId], references: [id])
  transaction         FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("expenses")
  @@schema("stewardship")
}

/// [PRD-DERIVED] FR-STW-08 / H2 (project-based fundraising with a target).
model Project {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId          String        @map("branch_id") @db.Uuid
  name              String
  description       String?
  targetAmountMinor BigInt        @map("target_amount_minor")
  currency          String        @default("GHS") @db.Char(3)
  status            ProjectStatus @default(ACTIVE)
  createdByPersonId String        @map("created_by_person_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  pledges           Pledge[]
  branch            Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdByPerson   Person        @relation("ProjectCreatedBy", fields: [createdByPersonId], references: [id])

  @@index([branchId, status])
  @@map("projects")
  @@schema("stewardship")
}

/// [PRD-DERIVED] FR-STW-08: pledge/donation tracking with a single,
/// opt-in, non-repeating reminder (OQ-07's resolution - "never a repeated
/// or pressuring sequence").
model Pledge {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from Project.branchId - see GroupMembership's doc comment.
  branchId               String                @map("branch_id") @db.Uuid
  projectId              String                @map("project_id") @db.Uuid
  personId               String                @map("person_id") @db.Uuid
  pledgedAmountMinor     BigInt                @map("pledged_amount_minor")
  currency               String                @default("GHS") @db.Char(3)
  pledgedAt              DateTime              @default(now()) @map("pledged_at") @db.Timestamptz(6)
  reminderOptIn          Boolean               @default(false) @map("reminder_opt_in")
  reminderSentAt         DateTime?             @map("reminder_sent_at") @db.Timestamptz(6)
  fulfilledTransactionId String?               @map("fulfilled_transaction_id") @db.Uuid
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  fulfilledTransaction   FinancialTransaction? @relation(fields: [fulfilledTransactionId], references: [id])
  person                 Person                @relation(fields: [personId], references: [id], onDelete: Cascade)
  project                Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([personId])
  @@index([branchId])
  @@map("pledges")
  @@schema("stewardship")
}

/// [PRD-DERIVED] FR-STW-07's bank-deposit comparison half: "aggregate
/// Verified transactions into a weekly reconciliation view comparing
/// recorded totals against confirmed bank deposits." Previously flagged in
/// STEWARDSHIP_DESIGN_NOTES.md as "needs a schema addition, not an
/// application-layer guess" - this model is that addition. One row per
/// Bacenta per week (the acceptance criterion's own "per Bacenta" framing;
/// BR-STW-09/10's weekly cadence) - recorded by a Treasurer against a
/// physical bank-deposit slip. Not itself a FinancialTransaction state
/// transition (`FinancialTransactionService.reconcile()` still owns each
/// transaction's own `Verified -> Reconciled` step); a separate,
/// aggregate-level confirmation the weekly reconciliation view compares
/// against the SUM of that Bacenta's Verified-or-later transactions in the
/// same week window. `weekStartDate` (a plain Date, not a Timestamptz) is
/// the Monday that week begins - [INFERRED] no PRD section pins a
/// week-boundary convention.
model BankDepositConfirmation {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId             String   @map("branch_id") @db.Uuid
  groupId              String   @map("group_id") @db.Uuid
  weekStartDate        DateTime @map("week_start_date") @db.Date
  depositedAmountMinor BigInt   @map("deposited_amount_minor")
  currency             String   @default("GHS") @db.Char(3)
  bankReference        String?  @map("bank_reference")
  confirmedByPersonId  String   @map("confirmed_by_person_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  branch               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  confirmedByPerson    Person   @relation(fields: [confirmedByPersonId], references: [id], onUpdate: NoAction)
  group                Group    @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([groupId, weekStartDate])
  @@index([branchId, weekStartDate])
  @@map("bank_deposit_confirmations")
  @@schema("stewardship")
}

/// [PRD-DERIVED] PRD §12.8's flowchart: a single stream fed by six signal
/// source categories (attendance, group membership change, financial
/// giving, follow-up outcome, role assignment, visitor conversion).
/// Append-only by convention (no updatedAt), mirroring the event-log
/// pattern already established for financial_transaction_events.
model EngagementSignal {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  /// Deliberately not a Prisma relation object (no back-reference on
  /// Person) - this is a high-volume append-only stream and the FK is
  /// enforced at the database level in the migration SQL instead, to keep
  /// Prisma's generated client light for this table's write path.
  personId   String?  @map("person_id") @db.Uuid
  groupId    String?  @map("group_id") @db.Uuid
  signalType String   @map("signal_type")
  payload    Json
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  group      Group?   @relation(fields: [groupId], references: [id])

  @@index([branchId, signalType, occurredAt])
  @@index([personId])
  @@map("engagement_signals")
  @@schema("insights")
}

/// [PRD-DERIVED] FR-INS-01's three scope levels (Person/Group/Branch).
/// Holds the current/latest score per scope; pulse_score_history (below)
/// holds the full time series - mirroring the current-state-plus-event-log
/// shape the Blueprint already establishes for financial_transactions /
/// financial_transaction_events. This current/history split is an
/// inference by analogy, not a citation - see db/DESIGN_NOTES.md Open
/// Question #7.
model PulseScore {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId   String              @map("branch_id") @db.Uuid
  scopeType  PulseScoreScopeType @map("scope_type")
  scopeId    String              @map("scope_id") @db.Uuid
  score      Decimal             @db.Decimal(5, 2)
  computedAt DateTime            @map("computed_at") @db.Timestamptz(6)
  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([scopeType, scopeId])
  @@index([branchId, scopeType])
  @@map("pulse_scores")
  @@schema("insights")
}

/// [PRD-DERIVED] See PulseScore's doc comment - the full time series.
model PulseScoreHistory {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId   String              @map("branch_id") @db.Uuid
  scopeType  PulseScoreScopeType @map("scope_type")
  scopeId    String              @map("scope_id") @db.Uuid
  score      Decimal             @db.Decimal(5, 2)
  computedAt DateTime            @map("computed_at") @db.Timestamptz(6)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, scopeType, scopeId, computedAt])
  @@map("pulse_score_history")
  @@schema("insights")
}

/// [PRD-DERIVED] FR-INS-03 (trend/threshold alerts), FR-INS-05 (act on or
/// dismiss).
model Alert {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId           String              @map("branch_id") @db.Uuid
  scopeType          PulseScoreScopeType @map("scope_type")
  scopeId            String              @map("scope_id") @db.Uuid
  alertType          String              @map("alert_type")
  message            String?
  status             AlertStatus         @default(OPEN)
  resolvedByPersonId String?             @map("resolved_by_person_id") @db.Uuid
  resolvedAt         DateTime?           @map("resolved_at") @db.Timestamptz(6)
  triggeredAt        DateTime            @default(now()) @map("triggered_at") @db.Timestamptz(6)
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  resolvedByPerson   Person?             @relation("AlertResolvedBy", fields: [resolvedByPersonId], references: [id])

  @@index([branchId, status])
  @@map("alerts")
  @@schema("insights")
}

/// [Multi-Tenant Foundation, Phase 1] The tenant boundary above Council -
/// see `Council`'s own doc comment for the ONE TENANT = ONE COUNCIL
/// product decision this enforces (via `Council.tenantId @unique`, not by
/// collapsing the two concepts into one model).
///
/// Reintroduced here under its correct Prisma-facing name after a
/// `prisma db pull` re-introspection cycle (see db/schema.prisma's git
/// history / the Prisma/Postgres mismatch fix that added this comment)
/// generated a model literally named `tenants` with no existing `Tenant`
/// model to reconcile against - Prisma derives client delegate names
/// from the exact model name, so that produced `prisma.tenants`, not
/// `prisma.tenant`, breaking every caller (`db/seed.ts` included) written
/// against the intended name. `@@map("tenants")` restores the link to
/// the same physical table now that the model name no longer matches it
/// verbatim. No database/migration change - this is a schema-
/// representation fix only.
model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  council   Council?

  @@index([name])
  @@map("tenants")
  @@schema("platform")
}

/// Mirrors libs/rbac/src/lib/roles.ts's ROLES array exactly (PRD §17.2 +
/// Blueprint §8.6's ACTING_RESIDENT_PASTOR + the Usher role milestone's
/// USHER addition - see that file's own doc comment and
/// USHER_ROLE_PROPOSAL.md for why USHER exists despite not being a
/// literal §17.2 row).
///
/// [Multi-Tenant Foundation, Phase 1] `COUNCIL_TREASURER` (new -
/// Council-wide financial oversight, no existing role covered this) and
/// `SYSTEM_ADMINISTRATOR` (new - a platform role, not a church-hierarchy
/// role; deliberately distinct from `ADMIN`, which stays Branch-scoped
/// church administration - see `libs/rbac/src/lib/roles.ts`'s doc
/// comment for the full reasoning against reusing `ADMIN` for both
/// meanings). Both added via `ALTER TYPE ... ADD VALUE` in this phase's
/// migration, matching the Usher role milestone's own precedent.
enum Role {
  RESIDENT_PASTOR
  ACTING_RESIDENT_PASTOR
  ASSISTANT_PASTOR
  BACENTA_LEADER
  BASONTA_LEADER
  TREASURER
  WORKER
  MEMBER
  VISITOR
  ADMIN
  COUNCIL_OVERSEER
  USHER
  COUNCIL_TREASURER
  SYSTEM_ADMINISTRATOR

  @@schema("people")
}

/// [BLUEPRINT-EXACT] PRD §12.6: Group.type is exactly PASTORAL_CARE
/// (Bacenta) or MINISTRY (Basonta) - no Cluster type. See
/// db/DESIGN_NOTES.md's corrections table and Open Question #1.
enum GroupType {
  PASTORAL_CARE
  MINISTRY

  @@schema("people")
}

/// [BLUEPRINT-EXACT] PRD §12.6's Group lifecycle state diagram.
enum GroupLifecycleStatus {
  ACTIVE
  SPLITTING
  MERGING
  ARCHIVED

  @@schema("people")
}

/// [BLUEPRINT-EXACT] PRD §12.5's Person lifecycle-stage state diagram /
/// BR-PPL-03 - the complete, exact 7-state list.
enum LifecycleStage {
  VISITOR
  FIRST_TIME_GUEST
  FOLLOW_UP
  LAPSED
  ASSIGNED_TO_BACENTA
  SIX_WEEKS_PARTICIPATION
  MEMBER

  @@schema("people")
}

/// [PRD-DERIVED] FR-PC-06 / libs/rbac's ResourceContext.candidatePoimenStatus.
enum PoimenStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE

  @@schema("pastoral_care")
}

/// [PRD-DERIVED] PRD §15.8's decision tree (flag -> notify -> resolve or
/// escalate).
enum SilentDriftStatus {
  FLAGGED
  RESOLVED
  ESCALATED

  @@schema("pastoral_care")
}

/// [PRD-DERIVED] FR-PC-03/04 - not enumerated verbatim anywhere; a
/// reasonable minimal set for an assign -> escalate -> complete workflow.
/// See db/DESIGN_NOTES.md.
enum FollowUpTaskStatus {
  OPEN
  ESCALATED
  COMPLETED

  @@schema("pastoral_care")
}

/// [BLUEPRINT-EXACT] Blueprint §7.4's `type` CHECK constraint on
/// stewardship.financial_transactions, shown verbatim.
enum FinancialTransactionType {
  OFFERING
  TITHE
  SPECIAL_OFFERING
  PLEDGE
  DONATION
  EXPENSE

  @@schema("stewardship")
}

/// [PRD-DERIVED] PRD §12.7's inbound-transaction channel list.
enum FinancialTransactionChannel {
  CASH
  MOBILE_MONEY

  @@schema("stewardship")
}

/// [PRD-DERIVED] FR-STW-08 / H2 - not enumerated verbatim.
enum ProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@schema("stewardship")
}

/// [PRD-DERIVED] PRD §12.4 names a `status` field on Gathering without
/// enumerating its values - see db/DESIGN_NOTES.md Open Question #6.
enum GatheringStatus {
  SCHEDULED
  CANCELLED
  COMPLETED

  @@schema("gatherings")
}

/// [BLUEPRINT-EXACT] PRD §12.2: "a status (present, absent, excused)".
enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED

