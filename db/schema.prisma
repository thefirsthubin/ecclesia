/// [PRD-DERIVED] FR-MIN-02: "numeric staffing target against a specific
/// Gathering instance".
model StaffingTarget {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from Group.branchId - see GroupMembership's doc comment.
  branchId          String   @map("branch_id") @db.Uuid
  gatheringId       String   @map("gathering_id") @db.Uuid
  gathering         Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  groupId           String   @map("group_id") @db.Uuid
  group             Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  targetCount       Int      @map("target_count")
  createdByPersonId String   @map("created_by_person_id") @db.Uuid
  createdByPerson   Person   @relation("StaffingTargetCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  createdAt         DateTime @db.Timestamptz @default(now()) @map("created_at")
  updatedAt         DateTime @db.Timestamptz @updatedAt @map("updated_at")

  @@unique([gatheringId, groupId])
  @@index([branchId])
  @@map("staffing_targets")
  @@schema("ministry")
}

/// [PRD-DERIVED] §16.3: "lets a worker mark themselves unavailable for a
/// date range" - person-wide, not per-Basonta (a worker may serve more
/// than one Basonta).
model WorkerAvailability {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from Person.branchId - see GroupMembership's doc comment.
  branchId       String    @map("branch_id") @db.Uuid
  personId       String    @map("person_id") @db.Uuid
  person         Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  unavailableFrom DateTime @map("unavailable_from") @db.Date
  unavailableTo  DateTime  @map("unavailable_to") @db.Date
  reason         String?
  createdAt      DateTime  @db.Timestamptz @default(now()) @map("created_at")

  @@index([personId, unavailableFrom, unavailableTo])
  @@index([branchId])
  @@map("worker_availability")
  @@schema("ministry")
}

// ---------------------------------------------------------------------
// gatherings schema
