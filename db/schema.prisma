// Ecclesia database schema (Sprint 1.3 - Database Foundation).
//
// DRAFT, designed without the actual Blueprint §7.2-7.5 text - see
// db/DESIGN_NOTES.md for the evidence behind every entity and field below,
// and for the open questions that need the real Blueprint/PRD to close.
// Every model and enum here traces to something already committed in
// libs/rbac (roles, actions, the permission matrix, ActorContext/
// ResourceContext) or a domain library's README, not to the Blueprint
// text directly.
//
// Seven bounded-context Postgres schemas (Blueprint §7.2, count confirmed
// by apps/api/src/app/app.module.ts's module inventory): one per bounded
// context, using Prisma's `multiSchema` preview feature so the schema
// boundary is a real Postgres namespace, not just a Prisma-side grouping.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// Only the five schemas with real models are declared here - Prisma's
// multiSchema feature expects every declared schema to be used by at
// least one model/enum. `ministry` and `insights` are created as empty
// Postgres schemas directly in the hand-written migration SQL instead
// (see db/DESIGN_NOTES.md's "Deliberately not built" section for why),
// and should be added here once each has real models.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["people", "pastoral_care", "gatherings", "stewardship", "platform"]
}

// ---------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------

/// Mirrors libs/rbac/src/lib/roles.ts's ROLES array exactly (PRD §17.2 +
/// Blueprint §8.6's ACTING_RESIDENT_PASTOR). Prisma schemas can't import a
/// TypeScript const array, so this is a deliberately duplicated source of
/// truth - keep the two in sync by hand until a codegen step exists to
/// derive one from the other.
enum Role {
  RESIDENT_PASTOR
  ACTING_RESIDENT_PASTOR
  ASSISTANT_PASTOR
  BACENTA_LEADER
  BASONTA_LEADER
  TREASURER
  WORKER
  MEMBER
  VISITOR
  ADMIN
  COUNCIL_OVERSEER

  @@schema("people")
}

/// Exact values from libs/rbac/src/lib/types.ts's
/// `ResourceContext.candidatePoimenStatus` literal union.
enum PoimenStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE

  @@schema("people")
}

/// A Group's position in the Branch > Cluster > Bacenta > Basonta
/// hierarchy. See db/DESIGN_NOTES.md's Open Question #1 - unifying
/// Cluster/Bacenta/Basonta into one polymorphic `Group` table (instead of
/// three separate tables) is an inference by analogy to the codebase's
/// existing "Everything Is A Gathering" generalization pattern, not a
/// direct citation.
enum GroupType {
  CLUSTER
  BACENTA
  BASONTA

  @@schema("people")
}

/// Exactly the three stewardship.transaction.* actions in
/// libs/rbac/src/lib/actions.ts: record, verify, reconcile.
enum FinancialTransactionEventType {
  RECORDED
  VERIFIED
  RECONCILED

  @@schema("stewardship")
}

/// Only `request`/`approve` actions exist in libs/rbac - no evidence of a
/// reject/decline state (see db/DESIGN_NOTES.md Open Question #5).
enum ExpenseStatus {
  REQUESTED
  APPROVED

  @@schema("stewardship")
}

/// Mirrors libs/rbac/src/lib/types.ts's `Effect` type exactly.
enum AuthorizationEffect {
  ALLOW
  DENY

  @@schema("platform")
}

// ---------------------------------------------------------------------
// platform schema - Branch (org root), Configuration, AuditLog
// ---------------------------------------------------------------------

/// The top-level tenant/scope boundary referenced by every ActorContext
/// and ResourceContext in libs/rbac as `branchId`. Not itself a `Group`
/// row (Group only models Cluster/Bacenta/Basonta) - every ActorContext
/// requires a branchId unconditionally, unlike the other three levels,
/// which are all optional, so Branch is architecturally distinct, not
/// just the top of the same table.
model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  timezone  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  groups               Group[]
  persons              Person[]
  roleAssignments      RoleAssignment[]
  gatheringSeries      GatheringSeries[]
  gatherings           Gathering[]
  financialTxnEvents   FinancialTransactionEvent[]
  expenses             Expense[]
  followupTasks        FollowupTask[]
  pastoralNotes        PastoralNote[]
  configuration        Configuration?
  auditLogEntries      AuditLog[]

  @@map("branches")
  @@schema("platform")
}

/// `platform.configurations` - table name and field list both taken
/// verbatim from libs/rbac's BranchConfiguration doc comment and
/// libs/config's own README/scaffold comment. One row per Branch.
model Configuration {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId             String   @unique @map("branch_id") @db.Uuid
  branch               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// Configurable Gathering type names for this Branch (referenced by
  /// Gathering.gatheringType / GatheringSeries.gatheringType as plain
  /// strings, not a foreign key - see db/DESIGN_NOTES.md).
  gatheringTypes       String[] @map("gathering_types")
  /// Church Pulse weighted-scoring model inputs (PRD §12.8, per
  /// libs/domain/insights/README.md) - shape not evidenced beyond "Church
  /// Pulse weights" existing, so stored as opaque JSON.
  churchPulseWeights   Json     @map("church_pulse_weights")
  /// Exact name/type matches libs/rbac's BranchConfiguration.poimenGateEnabled.
  poimenGateEnabled    Boolean  @default(false) @map("poimen_gate_enabled")
  /// Follow-up SLA defaults (per libs/config) - shape not evidenced, opaque JSON.
  followupSlaDefaults  Json     @map("followup_sla_defaults")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("configurations")
  @@schema("platform")
}

/// Backs the scoped `platform.audit_log.read` action (Branch/Cluster/
/// OwnGroup per the permission matrix). See db/DESIGN_NOTES.md Open
/// Question #8 for whether this should exist as a table at all versus
/// being served from the pino log stream.
model AuditLog {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String?             @map("branch_id") @db.Uuid
  branch         Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actorPersonId  String              @map("actor_person_id") @db.Uuid
  /// The libs/rbac Action string, e.g. "stewardship.transaction.verify".
  action         String
  effect         AuthorizationEffect
  resourceType   String?             @map("resource_type")
  resourceId     String?             @map("resource_id")
  reason         String
  occurredAt     DateTime            @default(now()) @map("occurred_at")

  @@index([branchId, occurredAt])
  @@map("audit_log")
  @@schema("platform")
}

// ---------------------------------------------------------------------
// people schema
// ---------------------------------------------------------------------

/// Unifies Cluster/Bacenta/Basonta - see the GroupType enum's doc comment
/// and db/DESIGN_NOTES.md Open Question #1.
model Group {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  branch         Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type           GroupType
  /// Null for a top-level Cluster, or for a Bacenta/Basonta with no
  /// intermediate parent when a Branch does not use Clusters.
  parentGroupId  String?   @map("parent_group_id") @db.Uuid
  parentGroup    Group?    @relation("GroupHierarchy", fields: [parentGroupId], references: [id], onDelete: SetNull)
  childGroups    Group[]   @relation("GroupHierarchy")
  name           String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  roleAssignments   RoleAssignment[]
  groupMemberships  GroupMembership[]
  gatheringSeries   GatheringSeries[]
  gatherings        Gathering[]
  financialTxnEvents FinancialTransactionEvent[]
  followupTasks     FollowupTask[]

  @@index([branchId, type])
  @@map("groups")
  @@schema("people")
}

model Person {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  phone          String?
  email          String?
  /// PRD §12.5's lifecycle-stage state machine (per
  /// libs/domain/people/README.md) - state names not evidenced anywhere
  /// in this repo, so left as an unconstrained string rather than an
  /// invented enum. See db/DESIGN_NOTES.md Open Question #2.
  lifecycleStage String        @map("lifecycle_stage")
  poimenStatus   PoimenStatus  @default(NOT_STARTED) @map("poimen_status")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  roleAssignmentsHeld     RoleAssignment[]   @relation("RoleAssignmentPerson")
  roleAssignmentsGranted  RoleAssignment[]   @relation("RoleAssignmentGrantedBy")
  groupMemberships        GroupMembership[]
  createdGatheringSeries  GatheringSeries[]  @relation("GatheringSeriesCreatedBy")
  createdGatherings       Gathering[]        @relation("GatheringCreatedBy")
  attendanceRecords       Attendance[]       @relation("AttendancePerson")
  attendanceRecorded      Attendance[]       @relation("AttendanceRecordedBy")
  financialEventsActed    FinancialTransactionEvent[] @relation("FinancialEventActor")
  financialEventsRecorded FinancialTransactionEvent[] @relation("FinancialEventRecordedBy")
  expensesRequested       Expense[]          @relation("ExpenseRequestedBy")
  expensesApproved        Expense[]          @relation("ExpenseApprovedBy")
  followupTasksSubject    FollowupTask[]     @relation("FollowupTaskSubject")
  followupTasksAssigned   FollowupTask[]     @relation("FollowupTaskAssignedTo")
  followupTasksCreated    FollowupTask[]     @relation("FollowupTaskCreatedBy")
  pastoralNotesSubject    PastoralNote[]     @relation("PastoralNoteSubject")
  pastoralNotesAuthored   PastoralNote[]     @relation("PastoralNoteAuthor")

  @@index([branchId])
  @@map("persons")
  @@schema("people")
}

/// Time-bound Role Assignment - libs/rbac/src/lib/roles.ts's own doc
/// comment: "the succession runbook models interim authority as an
/// ordinary, time-bound Role Assignment."
model RoleAssignment {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId           String    @map("person_id") @db.Uuid
  person             Person    @relation("RoleAssignmentPerson", fields: [personId], references: [id], onDelete: Cascade)
  role               Role
  branchId           String    @map("branch_id") @db.Uuid
  branch             Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// The Cluster/Bacenta/Basonta this assignment is scoped to. Null for
  /// BRANCH/GLOBAL-scoped roles (e.g. RESIDENT_PASTOR, ADMIN), matching
  /// ActorContext's own optional clusterId/bacentaId/basontaId fields.
  groupId            String?   @map("group_id") @db.Uuid
  group              Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  grantedByPersonId  String?   @map("granted_by_person_id") @db.Uuid
  grantedByPerson    Person?   @relation("RoleAssignmentGrantedBy", fields: [grantedByPersonId], references: [id], onDelete: SetNull)
  effectiveFrom      DateTime  @default(now()) @map("effective_from")
  effectiveTo        DateTime? @map("effective_to")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([personId, effectiveFrom, effectiveTo])
  @@index([branchId, role])
  @@map("role_assignments")
  @@schema("people")
}

/// The temporal GROUP_MEMBERSHIP model - db/migrations/README.md's own
/// word, "temporal" (Blueprint §7.5). Reassigning a member closes the
/// current row (sets validTo) and opens a new one, rather than mutating a
/// single bacentaId foreign key - see db/DESIGN_NOTES.md Open Question #3
/// for the still-unconfirmed BR-PPL-01/02/04 invariants this should enforce
/// (e.g. at most one open membership per Person at a time - not yet a DB
/// constraint here, only an assumption).
model GroupMembership {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId   String    @map("person_id") @db.Uuid
  person     Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Must reference a Group with type BACENTA or BASONTA - enforced at
  /// the application layer for now, not a DB constraint (see
  /// db/DESIGN_NOTES.md Open Question #3).
  groupId    String    @map("group_id") @db.Uuid
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  validFrom  DateTime  @default(now()) @map("valid_from")
  validTo    DateTime? @map("valid_to")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([personId, validFrom, validTo])
  @@index([groupId, validFrom, validTo])
  @@map("group_memberships")
  @@schema("people")
}

// ---------------------------------------------------------------------
// gatherings schema
// ---------------------------------------------------------------------

/// Supports "recurrence-series handling" (libs/domain/gatherings/README.md).
model GatheringSeries {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  groupId          String?   @map("group_id") @db.Uuid
  group            Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// References Configuration.gatheringTypes by name, not by foreign key
  /// (see db/DESIGN_NOTES.md).
  gatheringType    String    @map("gathering_type")
  recurrenceRule   String?   @map("recurrence_rule")
  startDate        DateTime  @map("start_date")
  endDate          DateTime? @map("end_date")
  createdByPersonId String   @map("created_by_person_id") @db.Uuid
  createdByPerson  Person    @relation("GatheringSeriesCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  gatherings Gathering[]

  @@index([branchId])
  @@map("gathering_series")
  @@schema("gatherings")
}

/// "Everything Is A Gathering" (libs/domain/gatherings/README.md,
/// Blueprint §12.4/PRD §2.4 per that README) - one generalized table for
/// every Gathering type, distinguished by `gatheringType`, not a table
/// per type.
model Gathering {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId          String           @map("branch_id") @db.Uuid
  branch            Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  groupId           String?          @map("group_id") @db.Uuid
  group             Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  seriesId          String?          @map("series_id") @db.Uuid
  series            GatheringSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  gatheringType     String           @map("gathering_type")
  scheduledAt       DateTime         @map("scheduled_at")
  createdByPersonId String           @map("created_by_person_id") @db.Uuid
  createdByPerson   Person           @relation("GatheringCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  attendance Attendance[]

  @@index([branchId, scheduledAt])
  @@index([groupId, scheduledAt])
  @@map("gatherings")
  @@schema("gatherings")
}

/// No status enum - a row's existence means the Person was recorded
/// present. See db/DESIGN_NOTES.md's Traceability index. `branchId` is
/// denormalized from Gathering deliberately, to keep the RLS policy on
/// this table a simple column comparison instead of a subquery join.
model Attendance {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gatheringId       String   @map("gathering_id") @db.Uuid
  gathering         Gathering @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  personId          String   @map("person_id") @db.Uuid
  person            Person   @relation("AttendancePerson", fields: [personId], references: [id], onDelete: Cascade)
  branchId          String   @map("branch_id") @db.Uuid
  recordedByPersonId String  @map("recorded_by_person_id") @db.Uuid
  recordedByPerson  Person   @relation("AttendanceRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  recordedAt        DateTime @default(now()) @map("recorded_at")

  @@unique([gatheringId, personId])
  @@index([branchId])
  @@map("attendance")
  @@schema("gatherings")
}

// ---------------------------------------------------------------------
// stewardship schema
// ---------------------------------------------------------------------

/// The append-only Financial Transaction event log (Blueprint §7.4, per
/// db/migrations/README.md's own words) - an event-sourced ledger, not a
/// mutable row with a status column. `transactionId` groups the events of
/// one logical transaction; for a brand-new transaction it equals the
/// RECORDED event's own id. No `updatedAt` - nothing here is ever
/// updated; the migration's `prevent_financial_transaction_event_mutation`
/// trigger enforces that at the database level, not just by convention.
model FinancialTransactionEvent {
  id                  String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId       String                        @map("transaction_id") @db.Uuid
  eventType           FinancialTransactionEventType  @map("event_type")
  amount              Decimal                        @db.Decimal(12, 2)
  /// ISO 4217 currency code. No default - see db/DESIGN_NOTES.md.
  currency            String                         @db.Char(3)
  branchId            String                         @map("branch_id") @db.Uuid
  branch              Branch                         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  groupId             String?                        @map("group_id") @db.Uuid
  group               Group?                         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Who performed *this* event - the recorder for RECORDED, the
  /// verifier for VERIFIED, the reconciler for RECONCILED.
  actorPersonId       String                         @map("actor_person_id") @db.Uuid
  actorPerson         Person                         @relation("FinancialEventActor", fields: [actorPersonId], references: [id], onDelete: Restrict)
  /// Set on VERIFIED/RECONCILED events, copied from the transaction's
  /// original RECORDED event, so BR-STW-04
  /// (DIFFERENT_ACTOR_THAN_RECORDER, libs/rbac's record-level check) can
  /// be evaluated without joining back to it.
  recordedByPersonId  String?                        @map("recorded_by_person_id") @db.Uuid
  recordedByPerson    Person?                        @relation("FinancialEventRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  occurredAt          DateTime                       @default(now()) @map("occurred_at")
  metadata            Json?
  createdAt           DateTime                       @default(now()) @map("created_at")

  @@index([transactionId])
  @@index([branchId, occurredAt])
  @@map("financial_transaction_events")
  @@schema("stewardship")
}

model Expense {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId           String        @map("branch_id") @db.Uuid
  branch             Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  requestedByPersonId String       @map("requested_by_person_id") @db.Uuid
  requestedByPerson  Person        @relation("ExpenseRequestedBy", fields: [requestedByPersonId], references: [id], onDelete: Restrict)
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @db.Char(3)
  status             ExpenseStatus @default(REQUESTED)
  approvedByPersonId String?       @map("approved_by_person_id") @db.Uuid
  approvedByPerson   Person?       @relation("ExpenseApprovedBy", fields: [approvedByPersonId], references: [id], onDelete: SetNull)
  approvedAt         DateTime?     @map("approved_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([branchId, status])
  @@map("expenses")
  @@schema("stewardship")
}

// ---------------------------------------------------------------------
// pastoral_care schema
// ---------------------------------------------------------------------

model FollowupTask {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId            String    @map("branch_id") @db.Uuid
  branch              Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  groupId             String?   @map("group_id") @db.Uuid
  group               Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  personId            String    @map("person_id") @db.Uuid
  person              Person    @relation("FollowupTaskSubject", fields: [personId], references: [id], onDelete: Cascade)
  assignedToPersonId  String    @map("assigned_to_person_id") @db.Uuid
  assignedToPerson    Person    @relation("FollowupTaskAssignedTo", fields: [assignedToPersonId], references: [id], onDelete: Restrict)
  /// Not evidenced beyond create/update/read actions existing - see
  /// db/DESIGN_NOTES.md Open Question #9.
  status              String
  dueAt               DateTime? @map("due_at")
  createdByPersonId   String    @map("created_by_person_id") @db.Uuid
  createdByPerson     Person    @relation("FollowupTaskCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([branchId, status])
  @@index([assignedToPersonId])
  @@map("followup_tasks")
  @@schema("pastoral_care")
}

/// No `pastoral_care.notes.update` action exists in libs/rbac (only
/// read/create) - suggesting notes may be immutable once created, the
/// same pattern as the Financial Transaction event log. No `updatedAt`
/// for that reason; unconfirmed, see db/DESIGN_NOTES.md.
model PastoralNote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  personId       String   @map("person_id") @db.Uuid
  person         Person   @relation("PastoralNoteSubject", fields: [personId], references: [id], onDelete: Cascade)
  authorPersonId String   @map("author_person_id") @db.Uuid
  authorPerson   Person   @relation("PastoralNoteAuthor", fields: [authorPersonId], references: [id], onDelete: Restrict)
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([branchId])
  @@index([personId])
  @@map("pastoral_notes")
  @@schema("pastoral_care")
}
