/// [PRD-DERIVED] FR-GTH-02: recurring series generating dated instances.
model GatheringSeries {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId          String    @map("branch_id") @db.Uuid
  branch            Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  groupId           String?   @map("group_id") @db.Uuid
  group             Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// References Configuration.gatheringTypes by name, not a foreign key.
  type              String
  recurrenceRule    String?   @map("recurrence_rule")
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  createdByPersonId String    @map("created_by_person_id") @db.Uuid
  createdByPerson   Person    @relation("GatheringSeriesCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  createdAt         DateTime  @db.Timestamptz @default(now()) @map("created_at")
  updatedAt         DateTime  @db.Timestamptz @updatedAt @map("updated_at")

  gatherings Gathering[]

  @@index([branchId])
  @@map("gathering_series")
  @@schema("gatherings")
}

/// [BLUEPRINT-EXACT] PRD §12.4's exact field list: type, scheduledStart,
/// scheduledEnd, recurrenceRule (via series), venue, ownerGroupId
/// (nullable), status, plus a config JSON column for type-specific fields
/// (e.g. an OnlineGathering's stream URL).
model Gathering {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId        String           @map("branch_id") @db.Uuid
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ownerGroupId    String?          @map("owner_group_id") @db.Uuid
  ownerGroup      Group?           @relation(fields: [ownerGroupId], references: [id], onDelete: SetNull)
  seriesId        String?          @map("series_id") @db.Uuid
  series          GatheringSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  type            String
  scheduledStart  DateTime         @db.Timestamptz @map("scheduled_start")
  scheduledEnd    DateTime?        @db.Timestamptz @map("scheduled_end")
  venue           String?
  status          GatheringStatus  @default(SCHEDULED)
  /// Type-specific fields (e.g. stream URL for an online Gathering).
  config          Json?
  createdByPersonId String         @map("created_by_person_id") @db.Uuid
  createdByPerson Person           @relation("GatheringCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @db.Timestamptz @default(now()) @map("created_at")
  updatedAt       DateTime         @db.Timestamptz @updatedAt @map("updated_at")

  attendanceRecords        AttendanceRecord[]
  visitorIntakeSubmissions VisitorIntakeSubmission[]
  staffingTargets          StaffingTarget[]

  @@index([branchId, scheduledStart])
  @@index([ownerGroupId, scheduledStart])
  @@map("gatherings")
  @@schema("gatherings")
}

/// [BLUEPRINT-EXACT] Table renamed from `attendance` to `attendance_records`
/// to match the Blueprint's naming. PRD §12.2's exact 3-value status.
/// branch_id denormalized from Gathering so the RLS policy stays a simple
/// column comparison, not a join.
model AttendanceRecord {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gatheringId        String            @map("gathering_id") @db.Uuid
  gathering          Gathering         @relation(fields: [gatheringId], references: [id], onDelete: Cascade)
  personId           String            @map("person_id") @db.Uuid
  person             Person            @relation("AttendanceRecordPerson", fields: [personId], references: [id], onDelete: Cascade)
  branchId           String            @map("branch_id") @db.Uuid
  status             AttendanceStatus
  recordedByPersonId String            @map("recorded_by_person_id") @db.Uuid
  recordedByPerson   Person            @relation("AttendanceRecordRecordedBy", fields: [recordedByPersonId], references: [id], onDelete: Restrict)
  recordedAt         DateTime          @db.Timestamptz @default(now()) @map("recorded_at")

  @@unique([gatheringId, personId])
  @@index([branchId])
  @@map("attendance_records")
  @@schema("gatherings")
}

/// [PRD-DERIVED] FR-GTH-04; §16.1's minimal capture fields ("name, phone,
/// how they heard about the church").
model VisitorIntakeSubmission {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String     @map("branch_id") @db.Uuid
  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  gatheringId   String?    @map("gathering_id") @db.Uuid
  gathering     Gathering? @relation(fields: [gatheringId], references: [id], onDelete: SetNull)
  personId      String?    @map("person_id") @db.Uuid
  person        Person?    @relation(fields: [personId], references: [id], onDelete: SetNull)
  /// Raw captured form fields (name, phone, how they heard about the
  /// church, etc.) - shape not pinned beyond §16.1's minimal example list.
  submittedData Json       @map("submitted_data")
  createdAt     DateTime   @db.Timestamptz @default(now()) @map("created_at")

  @@index([branchId])
  @@map("visitor_intake_submissions")
  @@schema("gatherings")
}

// ---------------------------------------------------------------------
// stewardship schema
// ---------------------------------------------------------------------

/// [BLUEPRINT-EXACT] Blueprint §7.4's `financial_transactions` header row,
/// full DDL shown verbatim: type CHECK constraint, source_group_id,
/// giver_person_id, channel, amount stored as amount_minor BIGINT ("to
/// avoid float rounding error"), currency, current_state (denormalized).
model FinancialTransaction {
  id             String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String                       @map("branch_id") @db.Uuid
  branch         Branch                       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type           FinancialTransactionType
  sourceGroupId  String?                      @map("source_group_id") @db.Uuid
  sourceGroup    Group?                       @relation(fields: [sourceGroupId], references: [id], onDelete: SetNull)
  giverPersonId  String?                      @map("giver_person_id") @db.Uuid
  giverPerson    Person?                      @relation("FinancialTransactionGiver", fields: [giverPersonId], references: [id], onDelete: SetNull)
  channel        FinancialTransactionChannel?
  /// Stored in minor currency units (e.g. pesewas/cents) to avoid float
  /// rounding error - Blueprint §7.4's exact design rationale.
  amountMinor    BigInt                       @map("amount_minor")
  currency       String                       @default("GHS") @db.Char(3)
  /// Denormalized latest state, mirrored from the most recent
  /// financial_transaction_events row for this transaction.
  currentState   String                       @map("current_state")
  createdAt      DateTime                     @db.Timestamptz @default(now()) @map("created_at")

  events  FinancialTransactionEvent[]
  expense Expense?
  pledgesFulfilled Pledge[]

  @@index([branchId, type, currentState])
  @@map("financial_transactions")
  @@schema("stewardship")
}

/// [BLUEPRINT-EXACT] Blueprint §7.4's append-only event log, full DDL
/// shown verbatim: transaction_id, from_state, to_state (free-form text,
/// not a fixed enum - the real state machine has 8+ states across two
/// sub-flows per PRD §12.7), actor_user_id REFERENCES platform.users(id),
/// reason, occurred_at. No update/delete allowed - see
/// db/DESIGN_NOTES.md Open Question #2 for the enforcement mechanism.
model FinancialTransactionEvent {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String               @map("transaction_id") @db.Uuid
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fromState     String?              @map("from_state")
  toState       String               @map("to_state")
  actorUserId   String               @map("actor_user_id") @db.Uuid
  actorUser     User                 @relation("FinancialEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  reason        String?
  occurredAt    DateTime             @db.Timestamptz @default(now()) @map("occurred_at")

  @@index([transactionId])
  @@map("financial_transaction_events")
  @@schema("stewardship")
}

/// [PRD-DERIVED] FR-STW-09 (approver != requester, mandatory receipt
/// before a terminal state). Modeled as a 1:1 extension of a
/// financial_transactions row with type=EXPENSE, sharing that row's event
/// log for state history - see db/DESIGN_NOTES.md Open Question #5; this
/// relationship shape is my construction, not a citation.
model Expense {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from FinancialTransaction.branchId - see
  /// GroupMembership's doc comment.
  branchId            String                @map("branch_id") @db.Uuid
  transactionId       String                @unique @map("transaction_id") @db.Uuid
  transaction         FinancialTransaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  requestedByPersonId String                @map("requested_by_person_id") @db.Uuid
  requestedByPerson   Person                @relation("ExpenseRequestedBy", fields: [requestedByPersonId], references: [id], onDelete: Restrict)
  description         String
  category            String?
  receiptStorageKey   String?               @map("receipt_storage_key")
  approvedByPersonId  String?               @map("approved_by_person_id") @db.Uuid
  approvedByPerson    Person?               @relation("ExpenseApprovedBy", fields: [approvedByPersonId], references: [id], onDelete: SetNull)
  approvedAt          DateTime?             @db.Timestamptz @map("approved_at")
  createdAt           DateTime              @db.Timestamptz @default(now()) @map("created_at")
  updatedAt           DateTime              @db.Timestamptz @updatedAt @map("updated_at")

  @@index([branchId])
  @@map("expenses")
  @@schema("stewardship")
}

/// [PRD-DERIVED] FR-STW-08 / H2 (project-based fundraising with a target).
model Project {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId          String        @map("branch_id") @db.Uuid
  branch            Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  targetAmountMinor BigInt        @map("target_amount_minor")
  currency          String        @default("GHS") @db.Char(3)
  status            ProjectStatus @default(ACTIVE)
  createdByPersonId String        @map("created_by_person_id") @db.Uuid
  createdByPerson   Person        @relation("ProjectCreatedBy", fields: [createdByPersonId], references: [id], onDelete: Restrict)
  createdAt         DateTime      @db.Timestamptz @default(now()) @map("created_at")
  updatedAt         DateTime      @db.Timestamptz @updatedAt @map("updated_at")

  pledges Pledge[]

  @@index([branchId, status])
  @@map("projects")
  @@schema("stewardship")
}

/// [PRD-DERIVED] FR-STW-08: pledge/donation tracking with a single,
/// opt-in, non-repeating reminder (OQ-07's resolution - "never a repeated
/// or pressuring sequence").
model Pledge {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from Project.branchId - see GroupMembership's doc comment.
  branchId               String                @map("branch_id") @db.Uuid
  projectId              String                @map("project_id") @db.Uuid
  project                Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  personId               String                @map("person_id") @db.Uuid
  person                 Person                @relation(fields: [personId], references: [id], onDelete: Cascade)
  pledgedAmountMinor     BigInt                @map("pledged_amount_minor")
  currency               String                @default("GHS") @db.Char(3)
  pledgedAt              DateTime              @db.Timestamptz @default(now()) @map("pledged_at")
  reminderOptIn          Boolean               @default(false) @map("reminder_opt_in")
  reminderSentAt         DateTime?             @db.Timestamptz @map("reminder_sent_at")
  fulfilledTransactionId String?               @map("fulfilled_transaction_id") @db.Uuid
  fulfilledTransaction   FinancialTransaction? @relation(fields: [fulfilledTransactionId], references: [id], onDelete: SetNull)
  createdAt              DateTime              @db.Timestamptz @default(now()) @map("created_at")
  updatedAt              DateTime              @db.Timestamptz @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([personId])
  @@index([branchId])
  @@map("pledges")
  @@schema("stewardship")
}

// ---------------------------------------------------------------------
// insights schema
// ---------------------------------------------------------------------

/// [PRD-DERIVED] PRD §12.8's flowchart: a single stream fed by six signal
/// source categories (attendance, group membership change, financial
/// giving, follow-up outcome, role assignment, visitor conversion).
/// Append-only by convention (no updatedAt), mirroring the event-log
/// pattern already established for financial_transaction_events.
model EngagementSignal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// Deliberately not a Prisma relation object (no back-reference on
  /// Person) - this is a high-volume append-only stream and the FK is
  /// enforced at the database level in the migration SQL instead, to keep
  /// Prisma's generated client light for this table's write path.
  personId    String?  @map("person_id") @db.Uuid
  groupId     String?  @map("group_id") @db.Uuid
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  signalType  String   @map("signal_type")
  payload     Json
  occurredAt  DateTime @db.Timestamptz @map("occurred_at")
  createdAt   DateTime @db.Timestamptz @default(now()) @map("created_at")

  @@index([branchId, signalType, occurredAt])
  @@index([personId])
  @@map("engagement_signals")
  @@schema("insights")
}

/// [PRD-DERIVED] FR-INS-01's three scope levels (Person/Group/Branch).
/// Holds the current/latest score per scope; pulse_score_history (below)
/// holds the full time series - mirroring the current-state-plus-event-log
/// shape the Blueprint already establishes for financial_transactions /
/// financial_transaction_events. This current/history split is an
/// inference by analogy, not a citation - see db/DESIGN_NOTES.md Open
/// Question #7.
model PulseScore {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId   String              @map("branch_id") @db.Uuid
  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scopeType  PulseScoreScopeType @map("scope_type")
  scopeId    String              @map("scope_id") @db.Uuid
  score      Decimal             @db.Decimal(5, 2)
  computedAt DateTime            @db.Timestamptz @map("computed_at")

  @@unique([scopeType, scopeId])
  @@index([branchId, scopeType])
  @@map("pulse_scores")
  @@schema("insights")
}

/// [PRD-DERIVED] See PulseScore's doc comment - the full time series.
model PulseScoreHistory {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId   String              @map("branch_id") @db.Uuid
  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scopeType  PulseScoreScopeType @map("scope_type")
  scopeId    String              @map("scope_id") @db.Uuid
  score      Decimal             @db.Decimal(5, 2)
  computedAt DateTime            @db.Timestamptz @map("computed_at")
  createdAt  DateTime            @db.Timestamptz @default(now()) @map("created_at")

  @@index([branchId, scopeType, scopeId, computedAt])
  @@map("pulse_score_history")
  @@schema("insights")
}

/// [PRD-DERIVED] FR-INS-03 (trend/threshold alerts), FR-INS-05 (act on or
/// dismiss).
model Alert {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId           String      @map("branch_id") @db.Uuid
  branch             Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  scopeType          PulseScoreScopeType @map("scope_type")
  scopeId            String      @map("scope_id") @db.Uuid
  alertType          String      @map("alert_type")
  message            String?
  status             AlertStatus @default(OPEN)
  resolvedByPersonId String?     @map("resolved_by_person_id") @db.Uuid
  resolvedByPerson   Person?     @relation("AlertResolvedBy", fields: [resolvedByPersonId], references: [id], onDelete: SetNull)
  resolvedAt         DateTime?   @db.Timestamptz @map("resolved_at")
  triggeredAt        DateTime    @db.Timestamptz @default(now()) @map("triggered_at")

  @@index([branchId, status])
  @@map("alerts")
  @@schema("insights")
}
