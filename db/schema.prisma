// Ecclesia database schema (Sprint 1.3 - Database Foundation).
//
// Rebuilt against the real Blueprint/PRD text (docs/Ecclesia_PRD.md,
// docs/Ecclesia_Technical_Blueprint.md). See db/DESIGN_NOTES.md for the
// evidence behind every entity and field below - each model/field comment
// is tagged [BLUEPRINT-EXACT] (verbatim from Blueprint §7-9) or
// [PRD-DERIVED] (table named in Blueprint §7.2, columns derived from a
// cited FR-/BR-ID, not given verbatim anywhere). DESIGN_NOTES.md also
// lists the corrections made from the first (pre-Blueprint) draft and the
// open questions that remain genuinely unresolved by the source documents.
//
// Seven bounded-context Postgres schemas [BLUEPRINT-EXACT - §7.1 ADR-003,
// §7.2's schema-to-module mapping table]: people, pastoral_care, ministry,
// gatherings, stewardship, insights, platform. Prisma's `multiSchema`
// preview feature makes the schema boundary a real Postgres namespace.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["people", "pastoral_care", "ministry", "gatherings", "stewardship", "insights", "platform"]
}

// ---------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------

/// Mirrors libs/rbac/src/lib/roles.ts's ROLES array exactly (PRD §17.2 +
/// Blueprint §8.6's ACTING_RESIDENT_PASTOR).
enum Role {
  RESIDENT_PASTOR
  ACTING_RESIDENT_PASTOR
  ASSISTANT_PASTOR
  BACENTA_LEADER
  BASONTA_LEADER
  TREASURER
  WORKER
  MEMBER
  VISITOR
  ADMIN
  COUNCIL_OVERSEER

  @@schema("people")
}

/// [BLUEPRINT-EXACT] PRD §12.6: Group.type is exactly PASTORAL_CARE
/// (Bacenta) or MINISTRY (Basonta) - no Cluster type. See
/// db/DESIGN_NOTES.md's corrections table and Open Question #1.
enum GroupType {
  PASTORAL_CARE
  MINISTRY

  @@schema("people")
}

/// [BLUEPRINT-EXACT] PRD §12.6's Group lifecycle state diagram.
enum GroupLifecycleStatus {
  ACTIVE
  SPLITTING
  MERGING
  ARCHIVED

  @@schema("people")
}

/// [BLUEPRINT-EXACT] PRD §12.5's Person lifecycle-stage state diagram /
/// BR-PPL-03 - the complete, exact 7-state list.
enum LifecycleStage {
  VISITOR
  FIRST_TIME_GUEST
  FOLLOW_UP
  LAPSED
  ASSIGNED_TO_BACENTA
  SIX_WEEKS_PARTICIPATION
  MEMBER

  @@schema("people")
}

/// [PRD-DERIVED] FR-PC-06 / libs/rbac's ResourceContext.candidatePoimenStatus.
enum PoimenStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE

  @@schema("pastoral_care")
}

/// [PRD-DERIVED] PRD §15.8's decision tree (flag -> notify -> resolve or
/// escalate).
enum SilentDriftStatus {
  FLAGGED
  RESOLVED
  ESCALATED

  @@schema("pastoral_care")
}

/// [PRD-DERIVED] FR-PC-03/04 - not enumerated verbatim anywhere; a
/// reasonable minimal set for an assign -> escalate -> complete workflow.
/// See db/DESIGN_NOTES.md.
enum FollowUpTaskStatus {
  OPEN
  ESCALATED
  COMPLETED

  @@schema("pastoral_care")
}

/// [BLUEPRINT-EXACT] Blueprint §7.4's `type` CHECK constraint on
/// stewardship.financial_transactions, shown verbatim.
enum FinancialTransactionType {
  OFFERING
  TITHE
  SPECIAL_OFFERING
  PLEDGE
  DONATION
  EXPENSE

  @@schema("stewardship")
}

/// [PRD-DERIVED] PRD §12.7's inbound-transaction channel list.
enum FinancialTransactionChannel {
  CASH
  MOBILE_MONEY

  @@schema("stewardship")
}

/// [PRD-DERIVED] FR-STW-08 / H2 - not enumerated verbatim.
enum ProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@schema("stewardship")
}

/// [PRD-DERIVED] PRD §12.4 names a `status` field on Gathering without
/// enumerating its values - see db/DESIGN_NOTES.md Open Question #6.
enum GatheringStatus {
  SCHEDULED
  CANCELLED
  COMPLETED

  @@schema("gatherings")
}

/// [BLUEPRINT-EXACT] PRD §12.2: "a status (present, absent, excused)".
enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED

  @@schema("gatherings")
}

/// [PRD-DERIVED] FR-INS-05: alerts are acted on or dismissed.
enum AlertStatus {
  OPEN
  ACTED
  DISMISSED

  @@schema("insights")
}

/// [PRD-DERIVED] Scope of an insights.pulse_scores / pulse_score_history
/// row - FR-INS-01's three levels ("Person/Group/Branch level").
enum PulseScoreScopeType {
  PERSON
  GROUP
  BRANCH

  @@schema("insights")
}

/// [BLUEPRINT-EXACT] §8: Cognito supports two enrollment paths - phone+OTP
/// (volunteer tier) and email+password+MFA (Treasurer/Pastor/Admin tier).
enum AuthMethod {
  PHONE_OTP
  EMAIL_PASSWORD

  @@schema("platform")
}

/// Mirrors libs/rbac/src/lib/types.ts's `Effect` type exactly.
enum AuthorizationEffect {
  ALLOW
  DENY

  @@schema("platform")
}

// ---------------------------------------------------------------------
// platform schema
// ---------------------------------------------------------------------

/// [PRD-DERIVED] FR-ADM-03 ("Branch and Council as first-class entities
/// from Release 1"); PRD §12.3's ERD: COUNCIL ||--o{ BRANCH : oversees.
model Council {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @db.Timestamptz @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz @updatedAt @map("updated_at")

  branches Branch[]

  @@map("councils")
  @@schema("platform")
}

/// [BLUEPRINT-EXACT] Blueprint §7.2's table list; §7.3's RLS policy scopes
/// every Branch-scoped table to `branch_id`, making Branch the tenant root.
model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  councilId String   @map("council_id") @db.Uuid
  council   Council  @relation(fields: [councilId], references: [id], onDelete: Restrict)
  name      String
  timezone  String?
  createdAt DateTime @db.Timestamptz @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz @updatedAt @map("updated_at")

  users                     User[]
  groups                    Group[]
  persons                   Person[]
  roleAssignments           RoleAssignment[]
  gatheringSeries           GatheringSeries[]
  gatherings                Gathering[]
  visitorIntakeSubmissions  VisitorIntakeSubmission[]
  financialTransactions     FinancialTransaction[]
  projects                  Project[]
  followUpTasks             FollowUpTask[]
  silentDriftFlags          SilentDriftFlag[]
  pastoralNotes             PastoralNote[]
  engagementSignals         EngagementSignal[]
  pulseScores               PulseScore[]
  pulseScoreHistory         PulseScoreHistory[]
  alerts                    Alert[]
  configuration             Configuration?
  auditLogEntries           AuditLog[]
  processedEvents           ProcessedEvent[]

  @@map("branches")
  @@schema("platform")
}

/// [PRD-DERIVED] Blueprint §8 (Cognito-backed identity). Minimal shape for
/// Sprint 1.3 - only enough for other tables' actor_user_id/user_id
/// foreign keys to resolve. Full Cognito integration (MFA state, custom
/// attributes) is Sprint 1.4's scope - see db/DESIGN_NOTES.md.
model User {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId    String     @map("branch_id") @db.Uuid
  branch      Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  personId    String?    @unique @map("person_id") @db.Uuid
  person      Person?    @relation(fields: [personId], references: [id], onDelete: SetNull)
  cognitoSub  String     @unique @map("cognito_sub")
  authMethod  AuthMethod @map("auth_method")
  phone       String?
  email       String?
  mfaEnabled  Boolean    @default(false) @map("mfa_enabled")
  createdAt   DateTime   @db.Timestamptz @default(now()) @map("created_at")
  updatedAt   DateTime   @db.Timestamptz @updatedAt @map("updated_at")

  sessions                  Session[]
  roleAssignmentsGranted    RoleAssignment[]            @relation("RoleAssignmentGrantedBy")
  financialEventsActed      FinancialTransactionEvent[] @relation("FinancialEventActor")
  auditLogEntries           AuditLog[]

  @@index([branchId])
  @@map("users")
  @@schema("platform")
}

/// [PRD-DERIVED] Named in Blueprint §7.2's table list with no schema
/// detail elsewhere - the least-evidenced table in this migration. See
/// db/DESIGN_NOTES.md Open Question #4.
model Session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId    String?   @map("device_id")
  createdAt   DateTime  @db.Timestamptz @default(now()) @map("created_at")
  revokedAt   DateTime? @db.Timestamptz @map("revoked_at")

  @@index([userId])
  @@map("sessions")
  @@schema("platform")
}

/// [PRD-DERIVED] Table name/purpose from Blueprint §7.2; field list from
/// libs/rbac's BranchConfiguration doc comment (gatheringTypes,
/// followupSlaDefaults) plus [BLUEPRINT-EXACT] poimenGateEnabled
/// (Blueprint §9.3, exact field name) plus silentDriftConfig (PRD §15.8:
/// the N/M thresholds are "configuration", shape not otherwise specified).
model Configuration {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId             String   @unique @map("branch_id") @db.Uuid
  branch               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  gatheringTypes       String[] @map("gathering_types")
  churchPulseWeights   Json     @map("church_pulse_weights")
  /// [BLUEPRINT-EXACT] Blueprint §9.3: "reads a poimen_gate_enabled
  /// boolean from platform.configurations".
  poimenGateEnabled    Boolean  @default(false) @map("poimen_gate_enabled")
  followupSlaDefaults  Json     @map("followup_sla_defaults")
  /// [PRD-DERIVED] PRD §15.8 - silent-drift attendance/Bacenta thresholds
  /// (N, M), shape not pinned beyond being Branch-configurable.
  silentDriftConfig    Json     @map("silent_drift_config")
  createdAt            DateTime @db.Timestamptz @default(now()) @map("created_at")
  updatedAt            DateTime @db.Timestamptz @updatedAt @map("updated_at")

  @@map("configurations")
  @@schema("platform")
}

/// [BLUEPRINT-EXACT] Table named in §7.2; actor tracked via `actor_user_id`
/// per §8.5 ("every authentication event... logged... with the
/// authenticated user, device identifier, IP address") and by analogy to
/// §7.4's actor_user_id pattern for the RBAC-denial-logging use case.
model AuditLog {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId     String?             @map("branch_id") @db.Uuid
  branch       Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actorUserId  String?             @map("actor_user_id") @db.Uuid
  actorUser    User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// The libs/rbac Action string, e.g. "stewardship.transaction.verify",
  /// or an auth-event name for §8.5's login/logout/MFA logging use case.
  action       String
  effect       AuthorizationEffect?
  resourceType String?             @map("resource_type")
  resourceId   String?             @map("resource_id")
  reason       String?
  deviceId     String?             @map("device_id")
  ipAddress    String?             @map("ip_address")
  occurredAt   DateTime            @db.Timestamptz @default(now()) @map("occurred_at")

  @@index([branchId, occurredAt])
  @@map("audit_log")
  @@schema("platform")
}

/// [BLUEPRINT-EXACT] Blueprint §10.5: "EventBridge/SQS provide
/// at-least-once delivery... every consumer... uses `eventId` as an
/// idempotency key: a `processed_events` table (per consumer) records
/// which `eventId`s have already been applied, and processing is a
/// no-op on replay." `consumerName` distinguishes the three named
/// consumers (§10.2: `insights-consumer`, `notification-consumer`,
/// `audit-consumer`) sharing one physical table rather than three - a
/// single table with a compound unique index is simpler than three
/// near-identical tables for the same "have I seen this eventId before"
/// check, and Prisma/Postgres both handle a compound unique index at
/// this scale without difficulty. `branchId` is carried because every
/// `EngagementSignalEnvelope` (§10.3) already includes one - denormalized
/// here the same way every other Branch-scoped table in this schema
/// denormalizes it, so the standard RLS `branch_isolation` policy applies
/// unchanged (see db/DESIGN_NOTES.md Worker milestone entry).
model ProcessedEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  consumerName String   @map("consumer_name")
  eventId      String   @map("event_id") @db.Uuid
  processedAt  DateTime @db.Timestamptz @default(now()) @map("processed_at")

  @@unique([consumerName, eventId])
  @@index([branchId])
  @@map("processed_events")
  @@schema("platform")
}

// ---------------------------------------------------------------------
// people schema
// ---------------------------------------------------------------------

/// [BLUEPRINT-EXACT] PRD §12.6 - unifies Bacenta (PASTORAL_CARE) and
/// Basonta (MINISTRY) via the `type` discriminator. No Cluster type and no
/// parent/child hierarchy - see db/DESIGN_NOTES.md's corrections table.
model Group {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId        String                @map("branch_id") @db.Uuid
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  type            GroupType
  name            String
  /// [PRD-DERIVED] FR-PC-01: Bacenta creation captures "name, leader,
  /// meeting schedule, meeting location" - leader is a RoleAssignment, the
  /// rest are plain fields.
  meetingSchedule String?               @map("meeting_schedule")
  meetingLocation String?               @map("meeting_location")
  /// [PRD-DERIVED] FR-MIN-01: Basonta creation captures "name, leader,
  /// purpose/category".
  category        String?
  /// [BLUEPRINT-EXACT] PRD §12.6's lifecycle state diagram.
  lifecycleStatus GroupLifecycleStatus  @default(ACTIVE) @map("lifecycle_status")
  createdAt       DateTime              @db.Timestamptz @default(now()) @map("created_at")
  updatedAt       DateTime              @db.Timestamptz @updatedAt @map("updated_at")

  roleAssignments          RoleAssignment[]
  groupMemberships         GroupMembership[]
  gatheringSeries          GatheringSeries[]
  gatherings               Gathering[]
  staffingTargets          StaffingTarget[]
  followUpTasks            FollowUpTask[]
  silentDriftFlags         SilentDriftFlag[]
  financialTransactions    FinancialTransaction[]
  engagementSignals        EngagementSignal[]

  @@index([branchId, type])
  @@map("groups")
  @@schema("people")
}

/// [BLUEPRINT-EXACT] Blueprint §7.2: "includes optional nullable
/// guardian_person_id" on persons.
model Person {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId         String          @map("branch_id") @db.Uuid
  branch           Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  firstName        String          @map("first_name")
  lastName         String          @map("last_name")
  phone            String?
  email            String?
  dateOfBirth      DateTime?       @map("date_of_birth") @db.Date
  address          String?
  /// [BLUEPRINT-EXACT] PRD §12.5 / BR-PPL-03's exact 7-state list.
  lifecycleStage   LifecycleStage  @default(VISITOR) @map("lifecycle_stage")
  /// [BLUEPRINT-EXACT] Blueprint §7.2's guardian_person_id, self-FK,
  /// nullable - PRD §24 OQ-01 / FR-PPL-09 (minors).
  guardianPersonId String?         @map("guardian_person_id") @db.Uuid
  guardian         Person?         @relation("PersonGuardian", fields: [guardianPersonId], references: [id], onDelete: SetNull)
  dependents       Person[]        @relation("PersonGuardian")
  /// [PRD-DERIVED] FR-PPL-08 - configurable custom profile fields, shape
  /// not further specified. See db/DESIGN_NOTES.md.
  customFields     Json?           @map("custom_fields")
  createdAt        DateTime        @db.Timestamptz @default(now()) @map("created_at")
  updatedAt        DateTime        @db.Timestamptz @updatedAt @map("updated_at")

  user                       User?
  roleAssignmentsHeld        RoleAssignment[]           @relation("RoleAssignmentPerson")
  groupMemberships           GroupMembership[]
  poimenEnrollment           PoimenEnrollment?
  createdGatheringSeries     GatheringSeries[]          @relation("GatheringSeriesCreatedBy")
  createdGatherings          Gathering[]                @relation("GatheringCreatedBy")
  attendanceRecords          AttendanceRecord[]         @relation("AttendanceRecordPerson")
  attendanceRecorded         AttendanceRecord[]         @relation("AttendanceRecordRecordedBy")
  visitorIntakeSubmission    VisitorIntakeSubmission[]
  workerAvailability         WorkerAvailability[]
  staffingTargetsCreated     StaffingTarget[]           @relation("StaffingTargetCreatedBy")
  financialTransactionsGiven FinancialTransaction[]     @relation("FinancialTransactionGiver")
  expensesRequested          Expense[]                  @relation("ExpenseRequestedBy")
  expensesApproved           Expense[]                  @relation("ExpenseApprovedBy")
  projectsCreated            Project[]                  @relation("ProjectCreatedBy")
  pledges                    Pledge[]
  followUpTasksSubject       FollowUpTask[]              @relation("FollowUpTaskSubject")
  followUpTasksAssigned      FollowUpTask[]              @relation("FollowUpTaskAssignedTo")
  followUpTasksEscalatedTo   FollowUpTask[]              @relation("FollowUpTaskEscalatedTo")
  followUpTasksCreated       FollowUpTask[]              @relation("FollowUpTaskCreatedBy")
  silentDriftFlagsSubject    SilentDriftFlag[]           @relation("SilentDriftFlagPerson")
  silentDriftFlagsAssigned   SilentDriftFlag[]           @relation("SilentDriftFlagShepherd")
  pastoralNotesSubject       PastoralNote[]               @relation("PastoralNoteSubject")
  pastoralNotesAuthored      PastoralNote[]               @relation("PastoralNoteAuthor")
  alertsResolved             Alert[]                      @relation("AlertResolvedBy")

  @@index([branchId])
  @@index([guardianPersonId])
  @@map("persons")
  @@schema("people")
}

/// [BLUEPRINT-EXACT] Table named in §7.2. Actor-tracking fields use
/// person_id (not user_id) for `grantedByPersonId` deliberately - see
/// db/DESIGN_NOTES.md's corrections table on the person_id vs user_id
/// distinction ("who is responsible for" vs. "which authenticated session
/// performed a security-relevant mutation").
model RoleAssignment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  personId          String    @map("person_id") @db.Uuid
  person            Person    @relation("RoleAssignmentPerson", fields: [personId], references: [id], onDelete: Cascade)
  role              Role
  branchId          String    @map("branch_id") @db.Uuid
  branch            Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// The Bacenta/Basonta this assignment is scoped to. Null for
  /// Branch/Global-scoped roles.
  groupId           String?   @map("group_id") @db.Uuid
  group             Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// [PRD-DERIVED] Open Question #1 - the Assistant Pastor "cluster" scope
  /// has no defined schema shape in either document ("cluster assignment
  /// is itself a configuration, not a hard-coded structure" - PRD §17.2).
  /// Modeled as a plain array of Bacenta group ids, populated only for
  /// cluster-scoped assignments. Not a citation - see
  /// db/DESIGN_NOTES.md Open Question #1.
  scopeGroupIds     String[]  @default([]) @map("scope_group_ids") @db.Uuid
  grantedByUserId   String?   @map("granted_by_user_id") @db.Uuid
  grantedByUser     User?     @relation("RoleAssignmentGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  effectiveFrom     DateTime  @db.Timestamptz @default(now()) @map("effective_from")
  effectiveTo       DateTime? @db.Timestamptz @map("effective_to")
  createdAt         DateTime  @db.Timestamptz @default(now()) @map("created_at")
  updatedAt         DateTime  @db.Timestamptz @updatedAt @map("updated_at")

  @@index([personId, effectiveFrom, effectiveTo])
  @@index([branchId, role])
  @@map("role_assignments")
  @@schema("people")
}

/// [BLUEPRINT-EXACT] The temporal GROUP_MEMBERSHIP model, Blueprint §7.5's
/// exact DDL: started_at/ended_at (not valid_from/valid_to), required-on-
/// close `reason`, and a partial unique index enforcing exactly one active
/// PASTORAL_CARE membership per person (BR-PPL-01).
model GroupMembership {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from Person.branchId - every Branch-scoped table needs a
  /// direct branch_id column for Blueprint §7.3's RLS policy pattern.
  branchId   String    @map("branch_id") @db.Uuid
  personId   String    @map("person_id") @db.Uuid
  person     Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  groupId    String    @map("group_id") @db.Uuid
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Denormalized from Group.type at write time so the partial unique
  /// index below (Blueprint §7.5's exact mechanism) doesn't need a join.
  groupType  GroupType @map("group_type")
  startedAt  DateTime  @db.Timestamptz @default(now()) @map("started_at")
  endedAt    DateTime? @db.Timestamptz @map("ended_at")
  /// [BLUEPRINT-EXACT] Required when a membership is closed.
  reason     String?
  createdAt  DateTime  @db.Timestamptz @default(now()) @map("created_at")

  @@index([personId, startedAt, endedAt])
  @@index([groupId, startedAt, endedAt])
  @@index([branchId])
  @@map("group_memberships")
  @@schema("people")
}

// ---------------------------------------------------------------------
// pastoral_care schema
// ---------------------------------------------------------------------

/// [PRD-DERIVED] Table named in Blueprint §7.2; FR-PC-06 for the 3-value
/// status. Its own table, not a field on Person - Blueprint §7.2 lists
/// `poimen_enrollments` as a distinct pastoral_care table.
model PoimenEnrollment {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalized from Person.branchId - see GroupMembership's doc comment.
  branchId     String       @map("branch_id") @db.Uuid
  personId     String       @unique @map("person_id") @db.Uuid
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  status       PoimenStatus @default(NOT_STARTED)
  enrolledAt   DateTime?    @db.Timestamptz @map("enrolled_at")
  completedAt  DateTime?    @db.Timestamptz @map("completed_at")
  createdAt    DateTime     @db.Timestamptz @default(now()) @map("created_at")
  updatedAt    DateTime     @db.Timestamptz @updatedAt @map("updated_at")

  @@map("poimen_enrollments")
  @@schema("pastoral_care")
}

/// [PRD-DERIVED] FR-PC-03 (auto-created), FR-PC-04 (assignment to a
/// specific Person - "typically the Shepherd", SLA window, escalation).
model FollowUpTask {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId            String             @map("branch_id") @db.Uuid
  branch              Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  groupId             String?            @map("group_id") @db.Uuid
  group               Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  personId            String             @map("person_id") @db.Uuid
  person              Person             @relation("FollowUpTaskSubject", fields: [personId], references: [id], onDelete: Cascade)
  assignedToPersonId  String             @map("assigned_to_person_id") @db.Uuid
  assignedToPerson    Person             @relation("FollowUpTaskAssignedTo", fields: [assignedToPersonId], references: [id], onDelete: Restrict)
  status              FollowUpTaskStatus @default(OPEN)
  dueAt               DateTime?          @db.Timestamptz @map("due_at")
  escalatedAt         DateTime?          @db.Timestamptz @map("escalated_at")
  escalatedToPersonId String?            @map("escalated_to_person_id") @db.Uuid
  escalatedToPerson   Person?            @relation("FollowUpTaskEscalatedTo", fields: [escalatedToPersonId], references: [id], onDelete: SetNull)
  createdByPersonId   String?            @map("created_by_person_id") @db.Uuid
  createdByPerson     Person?            @relation("FollowUpTaskCreatedBy", fields: [createdByPersonId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @db.Timestamptz @default(now()) @map("created_at")
  updatedAt           DateTime           @db.Timestamptz @updatedAt @map("updated_at")

  @@index([branchId, status])
  @@index([assignedToPersonId])
  @@map("follow_up_tasks")
  @@schema("pastoral_care")
}

/// [PRD-DERIVED] §15.8's decision tree, operationalizing BR-PC-02's
/// silent-drift definition (attendance threshold N, Bacenta threshold M).
model SilentDriftFlag {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId                 String            @map("branch_id") @db.Uuid
  branch                   Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  groupId                  String            @map("group_id") @db.Uuid
  group                    Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  personId                 String            @map("person_id") @db.Uuid
  person                   Person            @relation("SilentDriftFlagPerson", fields: [personId], references: [id], onDelete: Cascade)
  attendanceMissedCount    Int               @map("attendance_missed_count")
  attendanceThreshold      Int               @map("attendance_threshold")
  bacentaMissedCount       Int               @map("bacenta_missed_count")
  bacentaThreshold         Int               @map("bacenta_threshold")
  status                   SilentDriftStatus @default(FLAGGED)
  assignedShepherdPersonId String?           @map("assigned_shepherd_person_id") @db.Uuid
  assignedShepherd         Person?           @relation("SilentDriftFlagShepherd", fields: [assignedShepherdPersonId], references: [id], onDelete: SetNull)
  resolvedAt               DateTime?         @db.Timestamptz @map("resolved_at")
  escalatedAt              DateTime?         @db.Timestamptz @map("escalated_at")
  createdAt                DateTime          @db.Timestamptz @default(now()) @map("created_at")

  @@index([branchId, status])
  @@map("silent_drift_flags")
  @@schema("pastoral_care")
}

/// [PRD-DERIVED] §16.2 capability list; NFR-PRIV-01 (ADMIN explicit-deny
/// already encoded in libs/rbac). No updatedAt - notes appear immutable
/// once created (no update action for this resource in libs/rbac).
model PastoralNote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  personId       String   @map("person_id") @db.Uuid
  person         Person   @relation("PastoralNoteSubject", fields: [personId], references: [id], onDelete: Cascade)
  authorPersonId String   @map("author_person_id") @db.Uuid
  authorPerson   Person   @relation("PastoralNoteAuthor", fields: [authorPersonId], references: [id], onDelete: Restrict)
  content        String   @db.Text
  createdAt      DateTime @db.Timestamptz @default(now()) @map("created_at")

  @@index([branchId])
  @@index([personId])
  @@map("pastoral_notes")
  @@schema("pastoral_care")
}

