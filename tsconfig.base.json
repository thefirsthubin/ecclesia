{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowJs": true,
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false,
    "isolatedModules": true,
    "paths": {
      "@ecclesia/contracts": ["libs/contracts/src/index.ts"],
      "@ecclesia/rbac": ["libs/rbac/src/index.ts"],
      "@ecclesia/config": ["libs/config/src/index.ts"],
      "@ecclesia/testing": ["libs/testing/src/index.ts"],
      "@ecclesia/domain-people": ["libs/domain/people/src/index.ts"],
      "@ecclesia/domain-pastoral-care": ["libs/domain/pastoral-care/src/index.ts"],
      "@ecclesia/domain-ministry": ["libs/domain/ministry/src/index.ts"],
      "@ecclesia/domain-gatherings": ["libs/domain/gatherings/src/index.ts"],
      "@ecclesia/domain-stewardship": ["libs/domain/stewardship/src/index.ts"],
      "@ecclesia/domain-insights": ["libs/domain/insights/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
