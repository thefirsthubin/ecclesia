{
  "name": "ecclesia",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Ecclesia - Church Operating System. Nx monorepo housing the API, background Worker, React Native mobile app, React web admin console, and shared domain/contract libraries described in the Ecclesia Technical Blueprint (PTB v2.0).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "nx run-many --target=build --all",
    "build:affected": "nx affected --target=build",
    "lint": "nx run-many --target=lint --all",
    "lint:affected": "nx affected --target=lint",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "test": "nx run-many --target=test --all",
    "test:affected": "nx affected --target=test",
    "typecheck": "nx run-many --target=typecheck --all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "nx graph",
    "affected:graph": "nx affected:graph"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@nx/eslint": "20.1.0",
    "@nx/eslint-plugin": "20.1.0",
    "@nx/js": "20.1.0",
    "@nx/jest": "20.1.0",
    "@nx/workspace": "20.1.0",
    "@swc-node/register": "~1.9.2",
    "@swc/core": "~1.7.26",
    "@types/node": "^20.16.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "lint-staged": "^15.2.10",
    "nx": "20.1.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
